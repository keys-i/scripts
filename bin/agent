def choose_agents(name: str) -> list[AgentSpec]:
    agents = registry()
    if name == "all":
        return list(agents.values())
    try:
        return [agents[name]]
    except KeyError as error:
        raise ToolError(
            f"unknown agent {name!r}; use `agent doctor --list-agents`"
        ) from error


def _read_json_lines(text: str) -> list[dict[str, object]]:
    records: list[dict[str, object]] = []
    stripped = text.strip()
    if not stripped:
        return records
    try:
        value = json.loads(stripped)
    except json.JSONDecodeError:
        for line in stripped.splitlines():
            try:
                value = json.loads(line)
            except json.JSONDecodeError:
                continue
            if isinstance(value, dict):
                records.append(value)
        return records
    if isinstance(value, list):
        return [item for item in value if isinstance(item, dict)]
    return [value] if isinstance(value, dict) else []


def _session_delete_steps(
    label: str,
    binary: str,
    text: str,
    delete_prefix: tuple[str, ...],
) -> list[Step]:
    session_ids = {
        session_id
        for record in _read_json_lines(text)
        if isinstance((session_id := record.get("id") or record.get("sessionID")), str)
        and 0 < len(session_id) <= 256
        and all(character.isprintable() for character in session_id)
    }
    return [
        Step(
            f"Delete {label} session {session_id}",
            (binary, *delete_prefix, session_id),
        )
        for session_id in sorted(session_ids)
    ]


def _codex_session_ids(root: Path) -> list[str]:
    session_ids: set[str] = set()
    for path in safe_targets(
        root,
        ("sessions/**/*.jsonl", "archived_sessions/*.jsonl"),
    ):
        try:
            session_ids.add(str(UUID(path.stem[-36:])))
        except ValueError:
            continue
    return sorted(session_ids)


def _native_cleanup_unavailable(spec: AgentSpec, kind: str) -> bool:
    if spec.binary is not None or kind not in {"sessions", "all"}:
        return False
    if spec.key == "codex":
        return bool(_codex_session_ids(spec.root))
    if spec.key == "claude-code":
        return kind == "all" and spec.root.exists()
    return spec.key in {"gemini-cli", "opencode", "kilo"} and spec.root.exists()


def _native_clean_steps(spec: AgentSpec, kind: str) -> list[Step]:
    binary = spec.binary
    if binary is None:
        return []

    if spec.key == "claude-code":
        if kind in {"sessions", "memories"}:
            warning(
                "Claude's native purge combines sessions and auto-memory; "
                "select `clean all` to preview it."
            )
            return []
        if kind != "all":
            return []
        print("Claude scope: every project recorded in CLAUDE_CONFIG_DIR.")
        command = (binary, "project", "purge", "--all")
        preview = run((*command, "--dry-run"), check=False, timeout=30)
        if preview.returncode == 1:
            print("No matching Claude project state was found.")
            return []
        if preview.returncode:
            warning(
                f"Claude purge preview exited {preview.returncode}; "
                "no Claude deletion was planned."
            )
            return []
        return [
            Step(
                "Purge all recorded Claude project state",
                (*command, "--yes"),
            )
        ]

    if kind not in {"sessions", "all"}:
        return []
    if spec.key == "codex":
        return [
            Step(
                f"Delete Codex session {session_id}",
                (binary, "delete", session_id, "--force"),
            )
            for session_id in _codex_session_ids(spec.root)
        ]
    if spec.key == "gemini-cli":
        run((binary, "--list-sessions"), check=False, timeout=20)
        warning(
            "Gemini session-list output has no stable machine-readable format; "
            "use `gemini --delete-session INDEX_OR_ID` for selected sessions."
        )
        return []
    if spec.key in {"opencode", "kilo"}:
        if spec.key == "opencode":
            list_command = (binary, "session", "list", "--format", "json")
            label = "OpenCode"
        else:
            list_command = (
                binary,
                "session",
                "list",
                "--all",
                "--format",
                "json",
            )
            label = "Kilo"
        result = run(
            list_command,
            capture=True,
            check=False,
            timeout=20,
        )
        if result.returncode:
            warning(
                f"{label} session listing exited {result.returncode}; "
                f"no {label} deletion was planned."
            )
            return []
        return _session_delete_steps(
            label,
            binary,
            result.stdout or "",
            ("session", "delete"),
        )
    return []


def clean(args: argparse.Namespace) -> int:
    heading(f"Agent clean · {args.kind}")
    targets: list[Path] = []
    steps: list[Step] = []
    blocked = 0
    selected = choose_agents(args.agent)
    for spec in selected:
        if _native_cleanup_unavailable(spec, args.kind):
            warning(f"{spec.label}: executable missing; conversations left untouched")
            blocked += 1
        else:
            steps.extend(_native_clean_steps(spec, args.kind))
        patterns: list[str] = []
        if args.kind in {"sessions", "all"}:
            patterns.extend(spec.sessions)
        if args.kind in {"memories", "all"}:
            patterns.extend(spec.memories)
        if args.kind in {"cache", "all"}:
            patterns.extend(spec.caches)
        if patterns:
            try:
                targets.extend(safe_targets(spec.root, patterns))
            except ToolError as error:
                warning(f"{spec.label}: skipped unsafe state root ({error})")
        if spec.note:
            warning(f"{spec.label}: {spec.note}")

    targets = sorted(set(targets), key=str)
    for path in targets:
        print(f"  delete {path}")
    show_steps(steps)
    if not targets and not steps:
        print("No safely automatable local state was found.")
        return 1 if blocked else 0
    items, total_bytes = target_usage(targets)
    print(
        f"Plan: {items} local item(s) ({total_bytes:,} bytes) across "
        f"{len(targets)} target(s); {len(steps)} native operation(s) "
        "(size unavailable)."
    )
    warning("Close every selected agent before applying this plan.")
    if not confirmed(
        apply=args.apply,
        yes=args.yes,
        prompt=f"wipe {args.kind} state for {args.agent}",
    ):
        return 1 if blocked else 0
    failed = blocked
    for step in steps:
        result = run(step.command, check=False)
        if result.returncode:
            warning(f"{step.label} exited {result.returncode}; continuing")
            failed += 1
    files, directories = remove_targets(targets)
    print(color(f"Removed {files} files and {directories} directories.", "1;32"))
    return 1 if failed else 0


def _config_error(path: Path) -> str | None:
    try:
        if path.suffix.lower() == ".json":
            json.loads(path.read_text(encoding="utf-8"))
        elif path.suffix.lower() == ".toml":
            tomllib.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError, tomllib.TOMLDecodeError) as error:
        return str(error)
    return None


def _existing_state_paths(spec: AgentSpec) -> tuple[Path, ...]:
    return tuple(
        dict.fromkeys(
            path
            for path in (spec.root, spec.skill_dir)
            if path is not None and path.exists()
        )
    )


def doctor(args: argparse.Namespace) -> int:
    if args.list_agents:
        print(f"{'AGENT':<16} {'STATUS':<18} {'MARKET':<12} NAME")
        for spec in registry().values():
            status = color("installed", "32") if spec.binary else color("missing", "2")
            market = "skills" if spec.skill_agent else "unsupported"
            print(f"{spec.key:<16} {status:<18} {market:<12} {spec.label}")
        return 0

    fixes: list[tuple[str, Path]] = []
    failed = 0
    for spec in choose_agents(args.agent):
        heading(spec.label)
        binary = spec.binary
        if binary is None:
            remaining = _existing_state_paths(spec)
            if remaining:
                print(color("! executable missing; local state remains", "33"))
                for path in remaining:
                    print(f"  {path}")
            else:
                print(color("○ not installed", "2"))
            continue
        print(color(f"✓ executable: {binary}", "32"))
        version = run((binary, "--version"), capture=True, check=False, timeout=10)
        output = (version.stdout or version.stderr or "").strip().splitlines()
        if version.returncode:
            print(color(f"✗ version check exited {version.returncode}", "31"))
            failed += 1
        elif output:
            print(f"  {output[0][:200]}")

        native_command = {
            "codex": (binary, "doctor", "--json"),
            "kilo": (binary, "config", "check"),
        }.get(spec.key)
        if native_command:
            native_doctor = run(
                native_command,
                capture=True,
                check=False,
                timeout=30,
            )
            report = (native_doctor.stdout or native_doctor.stderr or "").strip()
            if report:
                print(report)
            if native_doctor.returncode:
                print(
                    color(
                        f"✗ native doctor exited {native_doctor.returncode}",
                        "31",
                    )
                )
                failed += 1
            else:
                print(color("✓ native doctor passed", "32"))

        if spec.root.exists():
            print(color(f"✓ state root: {spec.root}", "32"))
            if os.name != "nt":
                mode = stat.S_IMODE(spec.root.stat().st_mode)
                if mode & 0o077:
                    print(color(f"! permissions are {mode:03o}; recommend 700", "33"))
                    fixes.append(("Restrict state-directory permissions", spec.root))
        else:
            print(color(f"○ installed but not initialized: {spec.root}", "2"))

        for relative in spec.configs:
            path = spec.root / relative
            if not path.is_file():
                continue
            if path.suffix.lower() not in {".json", ".toml"}:
                format_name = path.suffix.removeprefix(".").upper() or "unknown"
                print(
                    color(
                        f"○ syntax not parsed ({format_name}): {path.name}",
                        "2",
                    )
                )
                continue
            error = _config_error(path)
            if error:
                print(color(f"✗ invalid {path.name}: {error}", "31"))
                failed += 1
            else:
                print(color(f"✓ readable config: {path.name}", "32"))

        if spec.skill_dir is None:
            print("  no native Agent Skills target")
        elif not spec.skill_dir.exists():
            print(f"  no skills installed yet: {spec.skill_dir}")
        if spec.note:
            print(f"  note: {spec.note}")

    if args.fix:
        heading("Repair plan")
        for label, path in fixes:
            print(f"  {label}: {path}")
        if fixes and confirmed(
            apply=args.apply,
            yes=args.yes,
            prompt=f"apply {len(fixes)} agent repairs",
        ):
            for _, path in fixes:
                if os.name != "nt":
                    path.chmod(0o700)
            print(color("Repairs applied.", "1;32"))
    elif fixes:
        print("\nRun with --fix to preview safe permission/directory repairs.")
    return 1 if failed else 0


def market(args: argparse.Namespace) -> int:
    npx = find_program("npx")
    if npx is None:
        raise ToolError("npx is required; install a current Node.js release")
    if args.install:
        command = [npx, "--yes", SKILLS_PACKAGE, "add", args.install]
        if args.skill:
            command.extend(("--skill", args.skill))
        if args.agent == "all":
            command.extend(("--agent", "*"))
        else:
            spec = choose_agents(args.agent)[0]
            if spec.skill_agent is None:
                raise ToolError(f"{spec.label} does not natively load Agent Skills")
            command.extend(("--agent", spec.skill_agent))
        if args.global_install:
            command.append("--global")
        if not args.apply:
            command.append("--list")
            heading("Skill install preview")
            return run(command, check=False).returncode
        if args.yes:
            command.append("--yes")
        warning("Skills can contain executable code. Install only reviewed sources.")
        if not confirmed(
            apply=True,
            yes=args.yes,
            prompt=f"install skills from {args.install}",
        ):
            return 0
        result = run(command, check=False)
        if result.returncode == 0 and args.agent in registry():
            print(f"Reload with: {registry()[args.agent].reload_hint}")
        return result.returncode

    if not args.query and os.environ.get("SCRIPTS_TUI"):
        raise ToolError("enter a market query in the wizard")
    command = [npx, "--yes", SKILLS_PACKAGE, "find"]
    if args.query:
        command.append(args.query)
    heading("Indexed Agent Skills catalog")
    print("Results come from the live skills CLI index; coverage is not exhaustive.")
    return run(command, check=False).returncode


def self_test() -> int:
    from contextlib import redirect_stdout
    from io import StringIO
    from types import SimpleNamespace
    from unittest.mock import patch

    agents = registry()
    assert {"codex", "claude-code", "gemini-cli", "github-copilot"} <= agents.keys()
    assert agents["codex"].sessions == ("history.jsonl",)
    for key in (
        "github-copilot",
        "qwen-code",
        "kilo",
        "cline",
        "goose",
        "vibe",
        "amp",
        "cursor",
        "kiro-cli",
        "droid",
        "rovodev",
    ):
        assert not agents[key].sessions
        assert not agents[key].memories
    assert all(
        ".db" not in pattern
        for spec in agents.values()
        for pattern in (*spec.sessions, *spec.memories)
    )
    assert agents["aider"].skill_agent is None
    assert all(
        spec.skill_agent is not None for key, spec in agents.items() if key != "aider"
    )
    add = ["npx", "--yes", SKILLS_PACKAGE, "add", "owner/repository", "--agent"]
    market_cases = (
        (
            ["market", "--install", "owner/repository"],
            [*add, "*", "--list"],
        ),
        (
            ["market", "--install", "owner/repository", "--agent", "codex"],
            [*add, "codex", "--list"],
        ),
        (
            ["market", "--install", "owner/repository", "--apply", "--yes"],
            [*add, "*", "--yes"],
        ),
        (
            ["market", "--query", "python"],
            ["npx", "--yes", SKILLS_PACKAGE, "find", "python"],
        ),
    )
    with (
        patch(f"{__name__}.find_program", return_value="npx"),
        patch(
            f"{__name__}.run",
            return_value=SimpleNamespace(returncode=0),
        ) as market_run,
    ):
        for arguments, _expected in market_cases:
            assert market(parse_args(arguments)) == 0
    assert [call.args[0] for call in market_run.call_args_list] == [
        expected for _arguments, expected in market_cases
    ]
    assert _read_json_lines('{"id":"one"}\n{"id":"two"}') == [
        {"id": "one"},
        {"id": "two"},
    ]
    deletion_steps = _session_delete_steps(
        "Fixture",
        "fixture",
        '[{"id":"two"},{"sessionID":"one"},{"id":3},{"id":"two"}]',
        ("session", "delete"),
    )
    assert [step.command for step in deletion_steps] == [
        ("fixture", "session", "delete", "one"),
        ("fixture", "session", "delete", "two"),
    ]
    try:
        run(
            (sys.executable, "-c", "import time; time.sleep(1)"),
            capture=True,
            timeout=0.01,
        )
    except ToolError as error:
        assert "timed out" in str(error)
    else:
        raise AssertionError("command timeout was not enforced")
    with TemporaryDirectory() as temporary:
        root = Path(temporary) / "state"
        outside = Path(temporary) / "outside"
        root.mkdir()
        outside.mkdir()
        with patch.dict(
            os.environ,
            {
                "GEMINI_CLI_HOME": str(Path(temporary) / "gemini-home"),
                "QWEN_HOME": str(Path(temporary) / "qwen-home"),
                "PI_CODING_AGENT_SESSION_DIR": str(Path(temporary) / "pi-sessions"),
            },
        ):
            overridden = registry()
        assert overridden["gemini-cli"].root == (
            Path(temporary) / "gemini-home/.gemini"
        )
        assert overridden["qwen-code"].root == Path(temporary) / "qwen-home"
        assert overridden["pi"].root == Path(temporary) / "pi-sessions"
        session_id = "12345678-1234-5678-9234-567812345678"
        session_dir = root / "sessions/2026/07/27"
        session_dir.mkdir(parents=True)
        (session_dir / f"rollout-2026-07-27T00-00-00-{session_id}.jsonl").touch()
        (session_dir / "unrecognised.jsonl").touch()
        assert _codex_session_ids(root) == [session_id]
        codex = AgentSpec("codex", "Codex", (sys.executable,), root, None, None)
        assert _native_clean_steps(codex, "sessions")[0].command[1:] == (
            "delete",
            session_id,
            "--force",
        )
        missing_codex = AgentSpec(
            "codex",
            "Codex",
            ("scripts-test-missing-agent-cli",),
            root,
            None,
            None,
        )
        assert _native_cleanup_unavailable(missing_codex, "sessions")
        kilo = AgentSpec("kilo", "Kilo", (sys.executable,), root, None, None)
        with patch(
            f"{__name__}.run",
            return_value=SimpleNamespace(
                returncode=0,
                stdout='[{"id":"kilo-session"}]',
            ),
        ) as listed:
            kilo_steps = _native_clean_steps(kilo, "sessions")
        listed.assert_called_once_with(
            (
                sys.executable,
                "session",
                "list",
                "--all",
                "--format",
                "json",
            ),
            capture=True,
            check=False,
            timeout=20,
        )
        assert kilo_steps[0].command == (
            sys.executable,
            "session",
            "delete",
            "kilo-session",
        )
        usage = root / "cache"
        nested = usage / "nested"
        nested.mkdir(parents=True)
        (usage / "one").write_bytes(b"123")
        nested_file = nested / "two"
        nested_file.write_bytes(b"45")
        assert target_usage([usage, nested_file]) == (4, 5)
        partial = AgentSpec(
            "fixture",
            "Fixture",
            ("scripts-test-missing-agent-cli",),
            root,
            None,
            None,
        )
        assert _existing_state_paths(partial) == (root,)
        doctor_args = argparse.Namespace(
            list_agents=False,
            agent="fixture",
            fix=False,
            apply=False,
            yes=False,
        )
        output = StringIO()
        with (
            patch(f"{__name__}.choose_agents", return_value=[partial]),
            patch(f"{__name__}.find_program", return_value=None),
            redirect_stdout(output),
        ):
            assert doctor(doctor_args) == 0
        assert "executable missing; local state remains" in output.getvalue()
        fresh = AgentSpec(
            "fixture",
            "Fixture",
            ("fixture",),
            Path(temporary) / "fresh",
            None,
            None,
        )
        output = StringIO()
        with (
            patch(f"{__name__}.choose_agents", return_value=[fresh]),
            patch(f"{__name__}.find_program", return_value="fixture"),
            patch(
                f"{__name__}.run",
                return_value=SimpleNamespace(
                    returncode=0,
                    stdout="fixture 1.0\n",
                    stderr="",
                ),
            ),
            redirect_stdout(output),
        ):
            assert doctor(doctor_args) == 0
        assert "installed but not initialized" in output.getvalue()
        (outside / "session").touch()
        try:
            (root / "linked").symlink_to(outside, target_is_directory=True)
        except OSError:
            pass
        else:
            try:
                safe_targets(root, ("linked/*",))
            except ToolError:
                pass
            else:
                raise AssertionError("cleanup crossed a directory symlink")
    print(f"ok: {len(agents)} agent definitions and safe state contracts")
    return 0


def add_safety(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "--apply", action="store_true", help="perform the previewed work"
    )
    parser.add_argument("--yes", action="store_true", help="skip the APPLY prompt")


def parse_args(arguments: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="agent",
        description="Clean, diagnose, and extend local AI-agent CLIs.",
    )
    parser.add_argument("--self-test", action="store_true", help=argparse.SUPPRESS)
    subparsers = parser.add_subparsers(dest="command")

    clean_parser = subparsers.add_parser("clean", help="wipe selected local state")
    clean_parser.add_argument(
        "kind",
        nargs="?",
        choices=("sessions", "memories", "cache", "all"),
        default="sessions",
    )
    clean_parser.add_argument(
        "--kind",
        dest="kind_flag",
        choices=("sessions", "memories", "cache", "all"),
    )
    clean_parser.add_argument("--agent", default="all")
    add_safety(clean_parser)

    doctor_parser = subparsers.add_parser("doctor", help="check agent installations")
    doctor_parser.add_argument("--agent", default="all")
    doctor_parser.add_argument("--kind", help=argparse.SUPPRESS)
    doctor_parser.add_argument("--fix", action="store_true")
    doctor_parser.add_argument("--list-agents", action="store_true")
    add_safety(doctor_parser)

    market_parser = subparsers.add_parser("market", help="find and install skills")
    market_parser.add_argument("query", nargs="?")
    market_parser.add_argument("--query", dest="query_flag")
    market_parser.add_argument("--kind", help=argparse.SUPPRESS)
    market_parser.add_argument("--agent", default="all")
    market_parser.add_argument("--install", metavar="OWNER/REPO")
    market_parser.add_argument("--skill")
    market_parser.add_argument("--global", dest="global_install", action="store_true")
    add_safety(market_parser)

    args = parser.parse_args(arguments)
    if getattr(args, "kind_flag", None):
        args.kind = args.kind_flag
    if getattr(args, "query_flag", None):
        args.query = args.query_flag
    return args


def main(arguments: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if arguments is None else arguments)
    if args.self_test:
        return self_test()
    if args.command is None:
        args = parse_args(["doctor"])
    try:
        return {"clean": clean, "doctor": doctor, "market": market}[args.command](args)
    except (ToolError, OSError, TimeoutError) as error:
        print(f"agent: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
