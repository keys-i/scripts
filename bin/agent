    run,
    safe_targets,
    show_steps,
    target_usage,
    warning,
)

SKILLS_PACKAGE = "skills@1.5.22"


@dataclass(frozen=True)
class AgentSpec:
    key: str
    label: str
    binaries: tuple[str, ...]
    root: Path
    skill_agent: str | None
    skill_dir: Path | None
    sessions: tuple[str, ...] = ()
    memories: tuple[str, ...] = ()
    caches: tuple[str, ...] = ()
    configs: tuple[str, ...] = ()
    reload_hint: str = "start a new session"
    note: str = ""

    @property
    def binary(self) -> str | None:
        return find_program(*self.binaries)


def _xdg(name: str, fallback: Path) -> Path:
    return Path(os.environ.get(name, fallback)).expanduser()


