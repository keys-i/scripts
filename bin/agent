#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
"""Clean, diagnose, and extend local AI-agent CLIs."""

from __future__ import annotations

import argparse
import json
import os
import stat
import sys
import tomllib
from dataclasses import dataclass
from pathlib import Path
from tempfile import TemporaryDirectory

from _common import (
    Step,
    ToolError,
    color,
    confirmed,
    find_program,
    heading,
    remove_targets,
    run,
    safe_targets,
    show_steps,
    warning,
)


@dataclass(frozen=True)
class AgentSpec:
    key: str
    label: str
    binaries: tuple[str, ...]
    root: Path
    skill_agent: str | None
    skill_dir: Path | None
    sessions: tuple[str, ...] = ()
    memories: tuple[str, ...] = ()
    caches: tuple[str, ...] = ()
    configs: tuple[str, ...] = ()
    reload_hint: str = "start a new session"
    note: str = ""

    @property
    def binary(self) -> str | None:
        return find_program(*self.binaries)


def _xdg(name: str, fallback: Path) -> Path:
    return Path(os.environ.get(name, fallback)).expanduser()


