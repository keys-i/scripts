#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
"""Cross-platform disk inventory, health, recovery, and repair frontend."""

from __future__ import annotations

import argparse
import os
import plistlib
import re
import sys
from pathlib import Path

from _common import (
    Step,
    ToolError,
    apply_steps,
    elevated,
    find_program,
    heading,
    host_os,
    print_json,
    require_program,
    run,
    warning,
)


def powershell() -> str:
    return require_program("pwsh", "powershell")


def ps(script: str) -> tuple[str, ...]:
    return (
        powershell(),
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-Command",
        script,
    )


def _windows_target(target: str | None) -> tuple[str, str] | None:
    if target is None:
        return None
    value = target.strip()
    drive = value.rstrip(":\\/")
    if re.fullmatch(r"[A-Za-z]", drive):
        return "drive", drive.upper()
    match = re.fullmatch(r"(?:disk)?(\d+)", value, re.IGNORECASE)
    if match:
        return "disk", str(int(match.group(1)))
    raise ToolError("Windows target must be a drive letter or disk number")


def show(args: argparse.Namespace, platform: str) -> int:
    target = args.target or args.target_pos
    if not args.json:
        heading("Disk inventory")
    if platform == "linux":
        command = [
            require_program("lsblk"),
            "--bytes",
            "--output",
            "NAME,PATH,TYPE,SIZE,FSTYPE,FSVER,LABEL,UUID,MOUNTPOINTS,MODEL,SERIAL,ROTA,RO,RM",
        ]
        if args.json:
            command.append("--json")
        if target:
            command.append(target)
        return run(command, check=False, announce=not args.json).returncode
    if platform == "macos":
        diskutil = require_program("diskutil")
        command = [diskutil, "info" if target else "list"]
        if args.json:
            command.append("-plist")
        if target:
            command.append(target)
        result = run(
            command,
            capture=args.json,
            check=False,
            announce=not args.json,
        )
        if args.json and result.returncode == 0 and result.stdout:
            print_json(plistlib.loads(result.stdout.encode()))
        elif args.json and (detail := result.stderr or result.stdout):
            print(detail.rstrip(), file=sys.stderr)
        return result.returncode
    if platform == "windows":
        selected = _windows_target(target)
        if selected is None:
            query = "$d=Get-Disk;$v=Get-Volume;"
        elif selected[0] == "drive":
            drive = selected[1]
            query = (
                f"$v=Get-Volume -DriveLetter '{drive}' -ErrorAction Stop;"
                f"$p=Get-Partition -DriveLetter '{drive}' -ErrorAction Stop;"
                "$d=Get-Disk -Number $p.DiskNumber -ErrorAction Stop;"
            )
        else:
            number = selected[1]
            query = (
                f"$d=Get-Disk -Number {number} -ErrorAction Stop;"
                f"$v=Get-Partition -DiskNumber {number} "
                "-ErrorAction SilentlyContinue|Get-Volume "
                "-ErrorAction SilentlyContinue;"
            )
        script = (
            query + "$d=$d|Select-Object Number,FriendlyName,SerialNumber,"
            "BusType,PartitionStyle,OperationalStatus,HealthStatus,Size,"
            "IsBoot,IsSystem,IsReadOnly,IsOffline;"
            "$v=$v|Select-Object DriveLetter,FileSystemLabel,"
            "FileSystem,HealthStatus,OperationalStatus,Size,SizeRemaining;"
            + (
                "[pscustomobject]@{Disks=$d;Volumes=$v}|ConvertTo-Json -Depth 4"
                if args.json
                else "$d|Format-Table -AutoSize;$v|Format-Table -AutoSize"
            )
        )
        return run(ps(script), check=False, announce=not args.json).returncode
    raise ToolError(f"unsupported operating system: {platform}")


def health(args: argparse.Namespace, platform: str) -> int:
    target = args.target or args.target_pos
    heading("Disk health")
    if platform == "linux":
        inventory_status = run(
            (
                require_program("lsblk"),
                "-d",
                "-o",
                "NAME,PATH,SIZE,MODEL,SERIAL,TRAN,ROTA,STATE",
            ),
            check=False,
        ).returncode
        if inventory_status:
            return inventory_status
        smartctl = find_program("smartctl")
        if smartctl and target:
            return run(elevated((smartctl, "-H", "-A", target)), check=False).returncode
        if smartctl:
            print("\nSMART-capable devices:")
            return run(elevated((smartctl, "--scan-open")), check=False).returncode
        warning("Install smartmontools for SMART/NVMe health details.")
        if find_program("nvme"):
            return run(("nvme", "list"), check=False).returncode
        return 0
    if platform == "macos":
        diskutil = require_program("diskutil")
        status = run((diskutil, "info", target or "/"), check=False).returncode
        if status:
            return status
        if target and (smartctl := find_program("smartctl")):
            return run(elevated((smartctl, "-H", "-A", target)), check=False).returncode
        elif not find_program("smartctl"):
            warning("Install smartmontools for vendor SMART attributes.")
        return 0
    if platform == "windows":
        selected = _windows_target(target)
        if selected is None:
            query = "$d=Get-Disk;"
        elif selected[0] == "drive":
            drive = selected[1]
            query = (
                f"$p=Get-Partition -DriveLetter '{drive}' -ErrorAction Stop;"
                "$d=Get-Disk -Number $p.DiskNumber -ErrorAction Stop;"
            )
        else:
            query = f"$d=Get-Disk -Number {selected[1]} -ErrorAction Stop;"
        script = (
            query + "$d|ForEach-Object {$disk=$_;"
            "$r=$disk|Get-StorageReliabilityCounter "
            "-ErrorAction SilentlyContinue;"
            "[pscustomobject]@{DiskNumber=$disk.Number;"
            "Name=$disk.FriendlyName;Serial=$disk.SerialNumber;"
            "Health=$disk.HealthStatus;Status=$disk.OperationalStatus;"
            "Temperature=$r.Temperature;Wear=$r.Wear;"
            "ReadErrors=$r.ReadErrorsTotal;WriteErrors=$r.WriteErrorsTotal}}"
            "|Format-Table -AutoSize"
        )
        return run(ps(script), check=False).returncode
    raise ToolError(f"unsupported operating system: {platform}")


def _mounted_linux(target: str) -> bool:
    lsblk = require_program("lsblk")
    result = run(
        (lsblk, "--noheadings", "--output", "MOUNTPOINTS", target),
        capture=True,
        check=False,
    )
    if result.returncode:
        raise ToolError(f"could not verify whether {target} is mounted")
    return bool((result.stdout or "").strip())


def _linux_filesystem(target: str) -> str:
    result = run(
        (
            require_program("lsblk"),
            "--nodeps",
            "--noheadings",
            "--output",
            "FSTYPE",
            target,
        ),
        capture=True,
    )
    filesystem = (result.stdout or "").strip().casefold()
    if not filesystem:
        raise ToolError(f"could not identify the filesystem on {target}")
    return filesystem


def repair_steps(platform: str, target: str | None) -> tuple[list[Step], list[Step]]:
    if platform == "linux":
        if not target:
            raise ToolError("Linux repair requires --target /dev/DEVICE")
        if not Path(target).is_block_device():
            raise ToolError("Linux repair target must be an existing block device")
        filesystem = _linux_filesystem(target)
        if filesystem not in {"ext2", "ext3", "ext4"}:
            raise ToolError(
                f"automatic Linux repair supports ext2/3/4, not {filesystem}; "
                "use that filesystem's native repair guidance"
            )
        e2fsck = require_program("e2fsck")
        verify = [
            Step(
                "Check the ext filesystem read-only",
                elevated((e2fsck, "-f", "-n", target)),
                ok_codes=(0, 4),
            )
        ]
        repair = [
            Step(
                "Repair the unmounted ext filesystem",
                elevated((e2fsck, "-f", "-p", target)),
                ok_codes=(0, 1, 2, 3),
            )
        ]
        return verify, repair
    if platform == "macos":
        target = target or "/"
        diskutil = require_program("diskutil")
        whole_disk = bool(re.fullmatch(r"(?:/dev/)?disk\d+", target))
        verify_verb = "verifyDisk" if whole_disk else "verifyVolume"
        repair_verb = "repairDisk" if whole_disk else "repairVolume"
        return (
            [Step("Verify disk structures", (diskutil, verify_verb, target))],
            [Step("Repair disk structures", (diskutil, repair_verb, target))],
        )
    if platform == "windows":
        selected = _windows_target(target or "C")
        assert selected is not None
        if selected[0] != "drive":
            raise ToolError("Windows repair target must be a drive letter")
        drive = selected[1]
        return (
            [
                Step(
                    f"Scan volume {drive}:",
                    ps(f"Repair-Volume -DriveLetter '{drive}' -Scan"),
                )
            ],
            [
                Step(
                    f"Spot-fix volume {drive}:",
                    ps(f"Repair-Volume -DriveLetter '{drive}' -SpotFix"),
                )
            ],
        )
    raise ToolError(f"unsupported operating system: {platform}")


def fix(args: argparse.Namespace, platform: str) -> int:
    target = args.target or args.target_pos
    verify, repair = repair_steps(platform, target)
    if platform == "linux" and target and _mounted_linux(target):
        raise ToolError(f"{target} is mounted; unmount it before checking or repair")
    heading("Read-only verification")
    for step in verify:
        result = run(step.command, check=False)
        if platform == "linux" and result.returncode not in step.ok_codes:
            raise ToolError(
                f"read-only e2fsck failed with exit {result.returncode}; "
                "repair was not started"
            )
        if result.returncode:
            warning(
                f"verification exited {result.returncode}; review its findings "
                "before applying the repair plan"
            )
    heading("Repair plan")
    applied = apply_steps(
        repair,
        apply=args.apply,
        yes=args.yes,
        prompt=f"repair {target or 'the system volume'}",
    )
    if applied and platform == "linux":
        print("If e2fsck requested a reboot, reboot before remounting the filesystem.")
    return 0


def recovery_steps(
    platform: str,
    target: str | None,
    tool: str,
    destination: str | None,
) -> list[Step]:
    if tool == "mount":
        if not target:
            raise ToolError("read-only mount recovery requires a volume --target")
        if platform == "macos":
            return [
                Step(
                    "Mount the volume read-only",
                    (require_program("diskutil"), "mount", "readOnly", target),
                )
            ]
        if platform == "linux":
            return [
                Step(
                    "Mount the volume read-only",
                    (require_program("udisksctl"), "mount", "-b", target, "-o", "ro"),
                )
            ]
        raise ToolError("read-only mount recovery is not available on Windows")
    if tool == "testdisk":
        if platform == "windows":
            return [
                Step(
                    "Open TestDisk recovery",
                    (require_program("testdisk_win.exe", "testdisk"),),
                )
            ]
        if not target:
            raise ToolError("TestDisk recovery requires a device or image --target")
        return [
            Step(
                "Open TestDisk recovery",
                elevated((require_program(tool), target)),
            )
        ]
    if not destination:
        raise ToolError("PhotoRec requires --destination on another disk")
    output = Path(destination).expanduser().resolve()
    if not output.is_dir():
        raise ToolError("PhotoRec destination must be an existing directory")
    if platform == "windows":
        command = (
            require_program("photorec_win.exe", "photorec"),
            "/d",
            str(output),
        )
    else:
        if not target:
            raise ToolError("PhotoRec recovery requires a device or image --target")
        source = Path(target).expanduser().resolve()
        if source == output or source in output.parents:
            raise ToolError("recovery destination must not be on the source path")
        command = elevated(
            (require_program(tool), "/d", str(output), target),
        )
    return [
        Step(
            "Open PhotoRec recovery",
            command,
        )
    ]


def recovery_tool(platform: str, requested: str | None) -> str:
    return requested or ("testdisk" if platform == "windows" else "mount")


def recover(args: argparse.Namespace, platform: str) -> int:
    tool = recovery_tool(platform, args.tool)
    steps = recovery_steps(
        platform,
        args.target or args.target_pos,
        tool,
        args.destination,
    )
    heading("Recovery plan")
    if tool in {"testdisk", "photorec"}:
        warning("Recover files to a different physical disk.")
        if platform == "windows":
            warning("Select the source inside the recovery tool's device list.")
        if args.apply and os.environ.get("SCRIPTS_TUI"):
            raise ToolError(
                f"{tool} needs its own interactive terminal; run `disk recover` directly"
            )
    apply_steps(
        steps,
        apply=args.apply,
        yes=args.yes,
        prompt=f"start {tool} recovery",
    )
    return 0


def self_test() -> int:
    import json
    from contextlib import redirect_stderr, redirect_stdout
    from io import StringIO
    from types import SimpleNamespace
    from unittest.mock import patch

    if find_program("diskutil"):
        verify, repair = repair_steps("macos", "/")
        assert verify[0].command[-2:] == ("verifyVolume", "/")
        assert repair[0].command[-2:] == ("repairVolume", "/")
    assert re.fullmatch(r"(?:/dev/)?disk\d+", "/dev/disk2")
    assert _windows_target("C:\\") == ("drive", "C")
    assert _windows_target("disk07") == ("disk", "7")
    try:
        _windows_target("0;Remove-Item")
    except ToolError:
        pass
    else:
        raise AssertionError("Windows target accepted PowerShell syntax")
    assert recovery_tool("linux", None) == "mount"
    assert recovery_tool("macos", None) == "mount"
    assert recovery_tool("windows", None) == "testdisk"
    assert parse_args(["recover"]).tool is None
    inventory_args = argparse.Namespace(target=None, target_pos=None, json=True)

    def native_json(_command: object, **options: object) -> SimpleNamespace:
        assert options["announce"] is False
        if options.get("capture"):
            return SimpleNamespace(
                returncode=0,
                stdout=plistlib.dumps({"Disks": []}).decode(),
                stderr="",
            )
        print('{"Disks": []}')
        return SimpleNamespace(returncode=0, stdout=None, stderr=None)

    for platform in ("linux", "macos", "windows"):
        output = StringIO()
        with (
            patch(f"{__name__}.require_program", return_value="native-tool"),
            patch(f"{__name__}.run", side_effect=native_json),
            redirect_stdout(output),
        ):
            assert show(inventory_args, platform) == 0
        assert json.loads(output.getvalue()) == {"Disks": []}
    diagnostic = StringIO()
    with (
        patch(f"{__name__}.require_program", return_value="diskutil"),
        patch(
            f"{__name__}.run",
            return_value=SimpleNamespace(
                returncode=7,
                stdout="",
                stderr="native disk failure\n",
            ),
        ),
        redirect_stderr(diagnostic),
    ):
        assert show(inventory_args, "macos") == 7
    assert diagnostic.getvalue() == "native disk failure\n"
    health_args = argparse.Namespace(target=None, target_pos=None)
    with (
        patch(f"{__name__}.require_program", return_value="lsblk"),
        patch(
            f"{__name__}.run",
            return_value=SimpleNamespace(returncode=9),
        ),
    ):
        assert health(health_args, "linux") == 9
    with (
        patch(f"{__name__}.require_program", return_value="lsblk"),
        patch(f"{__name__}.find_program", side_effect=(None, "nvme")),
        patch(
            f"{__name__}.run",
            side_effect=(
                SimpleNamespace(returncode=0),
                SimpleNamespace(returncode=7),
            ),
        ),
        redirect_stderr(StringIO()),
    ):
        assert health(health_args, "linux") == 7
    with (
        patch.object(Path, "is_block_device", return_value=True),
        patch(f"{__name__}._linux_filesystem", return_value="ext4"),
        patch(f"{__name__}.require_program", return_value="e2fsck"),
        patch(f"{__name__}.elevated", side_effect=tuple),
    ):
        verify, repair = repair_steps("linux", "/dev/example")
    assert verify[0].command[-3:] == ("-f", "-n", "/dev/example")
    assert verify[0].ok_codes == (0, 4)
    assert repair[0].command[-3:] == ("-f", "-p", "/dev/example")
    assert repair[0].ok_codes == (0, 1, 2, 3)
    with (
        patch.object(Path, "is_block_device", return_value=True),
        patch(f"{__name__}._linux_filesystem", return_value="btrfs"),
    ):
        try:
            repair_steps("linux", "/dev/example")
        except ToolError as error:
            assert "supports ext2/3/4" in str(error)
        else:
            raise AssertionError("Linux repair accepted an unsupported filesystem")
    with patch(f"{__name__}.require_program", side_effect=lambda *names: names[0]):
        assert recovery_steps("windows", None, "testdisk", None)[0].command == (
            "testdisk_win.exe",
        )
    verify = [Step("Verify", ("e2fsck",), ok_codes=(0, 4))]
    repair_args = argparse.Namespace(
        target="/dev/example",
        target_pos=None,
        apply=False,
        yes=False,
    )
    with (
        patch(f"{__name__}.repair_steps", return_value=(verify, [])),
        patch(f"{__name__}._mounted_linux", return_value=False),
        patch(f"{__name__}.run", return_value=argparse.Namespace(returncode=8)),
    ):
        try:
            fix(repair_args, "linux")
        except ToolError as error:
            assert "repair was not started" in str(error)
        else:
            raise AssertionError("Linux repair continued after an operational failure")
    try:
        repair_steps("linux", "/definitely/not/a/block-device")
    except ToolError:
        pass
    else:
        raise AssertionError("Linux repair accepted a non-block-device target")
    try:
        recovery_steps(
            "linux",
            "/dev/example",
            "photorec",
            "/definitely/not/an/existing-directory",
        )
    except ToolError as error:
        assert "existing directory" in str(error)
    else:
        raise AssertionError("PhotoRec accepted a missing destination")
    if sys.platform.startswith("linux") and find_program("lsblk"):
        try:
            _mounted_linux("/definitely/not/a/block-device")
        except ToolError:
            pass
        else:
            raise AssertionError("Linux mount verification failed open")
    print("ok: disk command contracts for Linux, macOS, and Windows")
    return 0


def parse_args(arguments: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="disk",
        description="Show, check, recover, and repair disks with native OS tools.",
    )
    parser.add_argument(
        "command",
        nargs="?",
        choices=("show", "health", "recover", "fix"),
        default="show",
    )
    parser.add_argument("target_pos", nargs="?", metavar="TARGET")
    parser.add_argument("--target", help="disk, device, volume, or drive letter")
    parser.add_argument(
        "--tool",
        choices=("mount", "testdisk", "photorec"),
        help="recovery method (default: mount, or TestDisk on Windows)",
    )
    parser.add_argument("--destination", help="PhotoRec output directory")
    parser.add_argument(
        "--json", action="store_true", help="machine-readable inventory"
    )
    parser.add_argument(
        "--apply", action="store_true", help="perform the repair/recovery"
    )
    parser.add_argument("--yes", action="store_true", help="skip the APPLY prompt")
    parser.add_argument("--self-test", action="store_true", help=argparse.SUPPRESS)
    return parser.parse_args(arguments)


def main(arguments: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if arguments is None else arguments)
    if args.self_test:
        return self_test()
    try:
        return {
            "show": show,
            "health": health,
            "fix": fix,
            "recover": recover,
        }[args.command](args, host_os())
    except (ToolError, OSError, plistlib.InvalidFileException) as error:
        print(f"disk: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
