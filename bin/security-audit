"""Read-only cross-platform security posture and project vulnerability audit."""

from __future__ import annotations

import argparse
import json
import os
import re
import signal
import stat
import subprocess
import sys
import tempfile
import time
import unicodedata
import urllib.error
import urllib.request
from dataclasses import asdict, dataclass
from datetime import UTC, datetime
from pathlib import Path
from typing import Any
from urllib.parse import quote, urlsplit

from _common import ToolError, color, find_program, heading, host_os, print_json

CISA_KEV_URL = (
    "https://www.cisa.gov/sites/default/files/feeds/"
    "known_exploited_vulnerabilities.json"
)
SCANNERS = ("osv", "trivy", "gitleaks")
SCANNER_POLICY_FILES = {
    "osv": ("osv-scanner.toml",),
    "trivy": (".trivyignore", ".trivyignore.yaml", "trivy.yaml"),
    "gitleaks": (".gitleaks.toml", ".gitleaksignore"),
}
SEVERITIES = ("info", "low", "medium", "high", "critical")
SEVERITY_RANK = {name: rank for rank, name in enumerate(SEVERITIES)}
CVE_PATTERN = re.compile(r"\bCVE-\d{4}-\d{4,}\b", re.IGNORECASE)
CWE_PATTERN = re.compile(r"\bCWE-\d{1,6}\b", re.IGNORECASE)
ANSI_PATTERN = re.compile(r"\x1b\[[0-?]*[ -/]*[@-~]")
MAX_JSON_DEPTH = 24
MAX_JSON_ITEMS = 100_000
MAX_JSON_STRING = 16_384
MAX_OUTPUT_BYTES = 32 * 1024 * 1024
MAX_SARIF_RUNS = 16
MAX_SARIF_RULES = 20_000
MAX_SARIF_RESULTS = 10_000
MAX_KEV_RECORDS = 100_000
MAX_KEV_AGE_DAYS = 30
MAX_ALIASES = 64
KEV_HOSTS = {"cisa.gov", "www.cisa.gov"}
BIDI_CONTROLS = {
    "\u061c",
    "\u200e",
    "\u200f",
    "\u202a",
    "\u202b",
    "\u202c",
    "\u202d",
    "\u202e",
    "\u2066",
    "\u2067",
    "\u2068",
    "\u2069",
}
DISCLAIMER = (
    "This is a read-only best-effort audit, not proof that a system is secure. "
    "Validate findings before changing production systems."
)


@dataclass
class Finding:
    status: str
    severity: str
    identifier: str
    title: str
    source: str
    details: str
    remediation: str
    location: str | None = None
    aliases: tuple[str, ...] = ()
    references: tuple[str, ...] = ()
    kev: dict[str, str] | None = None
    cvss_score: float | None = None
    cvss_vector: str | None = None
    weaknesses: tuple[str, ...] = ()
    commit: str | None = None
    fingerprint: str | None = None


@dataclass(frozen=True)
class ProcessResult:
    returncode: int | None
    output: str
    timed_out: bool = False
    truncated: bool = False


def _clean_text(value: object, limit: int = 600) -> str:
    text = ANSI_PATTERN.sub("", str(value or ""))
    text = "".join(
        character
        for character in text
        if character not in BIDI_CONTROLS
        and unicodedata.category(character) not in {"Cc", "Cs"}
    )
    text = " ".join(text.split())
    return text if len(text) <= limit else f"{text[: limit - 1]}…"


def _safe_cli_text(value: str) -> str:
    if any(
        character in BIDI_CONTROLS or unicodedata.category(character) in {"Cc", "Cs"}
        for character in value
    ):
        raise argparse.ArgumentTypeError(
            "paths may not contain control, newline, or bidirectional override characters"
        )
    return value


def _validate_json(
    value: object,
    *,
    depth: int = 0,
    budget: list[int] | None = None,
) -> None:
    """Reject hostile nesting, collection counts, and oversized strings."""
    if budget is None:
        budget = [MAX_JSON_ITEMS]
    budget[0] -= 1
    if budget[0] < 0:
        raise ToolError(f"JSON exceeds the {MAX_JSON_ITEMS}-item limit")
    if depth > MAX_JSON_DEPTH:
        raise ToolError(f"JSON exceeds the {MAX_JSON_DEPTH}-level nesting limit")
    if isinstance(value, str):
        if len(value) > MAX_JSON_STRING:
            raise ToolError(
                f"JSON string exceeds the {MAX_JSON_STRING}-character limit"
            )
        return
    if isinstance(value, list):
        for item in value:
            _validate_json(item, depth=depth + 1, budget=budget)
        return
    if isinstance(value, dict):
        for key, item in value.items():
            _validate_json(key, depth=depth + 1, budget=budget)
            _validate_json(item, depth=depth + 1, budget=budget)


def _nested_text(value: object, limit: int = 600) -> str:
    if isinstance(value, dict):
        return _clean_text(value.get("text") or value.get("markdown"), limit)
    return _clean_text(value, limit)


def _object(value: object) -> dict[str, Any]:
    return value if isinstance(value, dict) else {}


def _aliases(pattern: re.Pattern[str], *values: object) -> tuple[str, ...]:
    aliases: set[str] = set()
    pending = list(values)
    budget = 512
    while pending and budget:
        budget -= 1
        value = pending.pop()
        if isinstance(value, str):
            for match in pattern.finditer(value):
                aliases.add(match.group(0).upper())
                if len(aliases) >= MAX_ALIASES:
                    pending.clear()
                    break
        elif isinstance(value, list):
            pending.extend(value[:128])
        elif isinstance(value, dict):
            pending.extend(list(value.values())[:128])
    return tuple(sorted(aliases))


def _cve_aliases(*values: object) -> tuple[str, ...]:
    return _aliases(CVE_PATTERN, *values)


def _default_kev_cache() -> Path:
    if os.name == "nt" and os.environ.get("LOCALAPPDATA"):
        root = Path(os.environ["LOCALAPPDATA"])
    elif sys.platform == "darwin":
        root = Path.home() / "Library" / "Caches"
    else:
        root = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
    return root / "scripts" / "cisa-kev.json"


def _atomic_private_write(path: Path, data: bytes, description: str) -> None:
    if path.is_symlink() or (path.exists() and not path.is_file()):
        raise ToolError(f"refusing unsafe {description} path: {path}")
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as handle:
            temporary = Path(handle.name)
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def _execute(
    command: list[str] | tuple[str, ...],
    *,
    timeout: int,
    max_bytes: int,
    watched_file: Path | None = None,
) -> ProcessResult:
    """Run fixed argv while bounding time, diagnostics, and an optional report."""
    with tempfile.TemporaryFile() as output:
        try:
            process = subprocess.Popen(
                command,
                stdin=subprocess.DEVNULL,
                stdout=output,
                stderr=subprocess.STDOUT,
                start_new_session=os.name != "nt",
            )
        except OSError as error:
            return ProcessResult(None, str(error))

        deadline = time.monotonic() + timeout
        timed_out = truncated = False
        while process.poll() is None:
            if time.monotonic() >= deadline:
                timed_out = True
                break
            if os.fstat(output.fileno()).st_size > max_bytes:
                truncated = True
                break
            if watched_file is not None:
                try:
                    metadata = watched_file.lstat()
                except FileNotFoundError:
                    pass
                except OSError:
                    truncated = True
                    break
                else:
                    if (
                        not stat.S_ISREG(metadata.st_mode)
                        or metadata.st_size > MAX_OUTPUT_BYTES
                    ):
                        truncated = True
                        break
            try:
                process.wait(timeout=min(0.1, max(0.01, deadline - time.monotonic())))
            except subprocess.TimeoutExpired:
                pass

        if process.poll() is None:
            output.seek(0)
            if os.name != "nt":
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
            else:
                process.kill()
            process.wait()

        output.seek(0)
        data = output.read(max_bytes + 1)
        return ProcessResult(
            None if timed_out else process.returncode,
            data[:max_bytes].decode("utf-8", "replace"),
            timed_out=timed_out,
            truncated=truncated or len(data) > max_bytes,
        )


def _probe(
    command: list[str] | tuple[str, ...],
    timeout: int,
    max_bytes: int,
) -> ProcessResult:
    return _execute(command, timeout=min(timeout, 30), max_bytes=min(max_bytes, 65536))


def _posture(
    identifier: str,
    title: str,
    value: bool | None,
    *,
    issue: str,
    remediation: str,
    severity: str = "medium",
    details: str = "",
    references: tuple[str, ...] = (),
) -> Finding:
    if value is True:
        return Finding(
            "pass",
            "info",
            identifier,
            title,
            "system",
            details or "Enabled.",
            "No action required.",
            references=references,
        )
    if value is False:
        return Finding(
            "issue",
            severity,
            identifier,
            title,
            "system",
            issue,
            remediation,
            references=references,
        )
    return Finding(
        "unknown",
        "info",
        identifier,
        title,
        "system",
        details or "Could not determine this setting with available native tools.",
        f"Verify manually. {remediation}",
        references=references,
    )


def _contains_state(
    result: ProcessResult,
    enabled: tuple[str, ...],
    disabled: tuple[str, ...],
) -> bool | None:
    if result.timed_out or result.returncode is None:
        return None
    text = result.output.casefold()
    if any(marker in text for marker in enabled):
        return True
    if any(marker in text for marker in disabled):
        return False
    return None


def _selinux_status(result: ProcessResult) -> tuple[bool | None, str]:
    state = result.output.strip().casefold()
    details = f"SELinux: {_clean_text(result.output)}" if result.output.strip() else ""
    if result.returncode != 0:
        return None, details
    return {"enforcing": True, "permissive": False, "disabled": False}.get(
        state
    ), details


def linux_posture(timeout: int, max_bytes: int) -> list[Finding]:
    findings: list[Finding] = []

    firewall_state: bool | None = None
    if program := find_program("ufw"):
        firewall_state = _contains_state(
            _probe((program, "status"), timeout, max_bytes),
            ("status: active",),
            ("status: inactive",),
        )
    elif program := find_program("firewall-cmd"):
        firewall_state = _contains_state(
            _probe((program, "--state"), timeout, max_bytes),
            ("running",),
            ("not running",),
        )
    elif program := find_program("nft"):
        result = _probe((program, "list", "ruleset"), timeout, max_bytes)
        if result.returncode == 0 and not result.output.strip():
            firewall_state = False
    findings.append(
        _posture(
            "linux-firewall",
            "Host firewall",
            firewall_state,
            issue="No active inbound firewall policy was detected.",
            remediation="Enable and review the distribution's native firewall rules.",
            severity="high",
        )
    )

    encryption: bool | None = None
    if findmnt := find_program("findmnt"):
        source = _probe(
            (findmnt, "--noheadings", "--output", "SOURCE", "/"),
            timeout,
            max_bytes,
        )
        root_source = (
            source.output.strip().splitlines()[0] if source.returncode == 0 else ""
        )
        if root_source.startswith("/dev/") and (lsblk := find_program("lsblk")):
            chain = _probe(
                (lsblk, "--inverse", "--noheadings", "--output", "FSTYPE", root_source),
                timeout,
                max_bytes,
            )
            if chain.returncode == 0:
                encryption = "crypto_luks" in chain.output.casefold()
    findings.append(
        _posture(
            "linux-root-encryption",
            "Root-disk encryption",
            encryption,
            issue="The root block-device chain did not include LUKS encryption.",
            remediation="Plan a backed-up migration to full-disk encryption.",
            severity="high",
        )
    )

    updates: bool | None = None
    saw_disabled = False
    if systemctl := find_program("systemctl"):
        for unit in (
            "unattended-upgrades.service",
            "dnf-automatic.timer",
            "dnf5-automatic.timer",
            "packagekit-offline-update.service",
        ):
            result = _probe((systemctl, "is-enabled", unit), timeout, max_bytes)
            state = result.output.strip().casefold()
            if result.returncode == 0 and state == "enabled":
                updates = True
                break
            saw_disabled |= state == "disabled"
        if updates is None and saw_disabled:
            updates = False
    findings.append(
        _posture(
            "linux-automatic-updates",
            "Automatic security updates",
            updates,
            issue="An installed automatic-update unit was disabled.",
            remediation="Enable the distribution's signed security-update service.",
        )
    )

    secure_boot: bool | None = None
    if mokutil := find_program("mokutil"):
        secure_boot = _contains_state(
            _probe((mokutil, "--sb-state"), timeout, max_bytes),
            ("secureboot enabled", "secure boot enabled"),
            ("secureboot disabled", "secure boot disabled"),
        )
    findings.append(
        _posture(
            "linux-secure-boot",
            "UEFI Secure Boot",
            secure_boot,
            issue="Secure Boot was reported disabled.",
            remediation="Verify signed boot components, then enable Secure Boot in firmware.",
        )
    )

    mandatory_access: bool | None = None
    mandatory_details = ""
    if getenforce := find_program("getenforce"):
        result = _probe((getenforce,), timeout, max_bytes)
        mandatory_access, mandatory_details = _selinux_status(result)
    elif apparmor := find_program("aa-enabled", "aa-status"):
        command = (
            (apparmor,)
            if Path(apparmor).name == "aa-enabled"
            else (
                apparmor,
                "--enabled",
            )
        )
        result = _probe(command, timeout, max_bytes)
        mandatory_access = (
            result.returncode == 0 if result.returncode is not None else None
        )
        mandatory_details = "AppArmor enabled." if mandatory_access else ""
    findings.append(
        _posture(
            "linux-mandatory-access-control",
            "Mandatory access control",
            mandatory_access,
            issue="SELinux or AppArmor was detected but not enforcing.",
            remediation="Enable an enforcing SELinux or AppArmor policy after compatibility testing.",
            severity="high",
            details=mandatory_details,
        )
    )

    controls = (
        (
            "linux-aslr",
            "Address-space randomization",
            "/proc/sys/kernel/randomize_va_space",
            lambda value: int(value) == 2,
            "Set kernel.randomize_va_space=2 through the distribution's sysctl policy.",
        ),
        (
            "linux-protected-hardlinks",
            "Protected hard links",
            "/proc/sys/fs/protected_hardlinks",
            lambda value: int(value) == 1,
            "Set fs.protected_hardlinks=1 through the distribution's sysctl policy.",
        ),
        (
            "linux-protected-symlinks",
            "Protected symbolic links",
            "/proc/sys/fs/protected_symlinks",
            lambda value: int(value) == 1,
            "Set fs.protected_symlinks=1 through the distribution's sysctl policy.",
        ),
        (
            "linux-ptrace",
            "Restricted process tracing",
            "/proc/sys/kernel/yama/ptrace_scope",
            lambda value: int(value) >= 1,
            "Set kernel.yama.ptrace_scope=1 or stricter if workloads permit it.",
        ),
    )
    for identifier, title, path_text, predicate, remediation in controls:
        value: bool | None = None
        try:
            value = predicate(Path(path_text).read_text(encoding="ascii").strip())
        except (OSError, ValueError):
            pass
        findings.append(
            _posture(
                identifier,
                title,
                value,
                issue="The kernel hardening control is below the recommended baseline.",
                remediation=remediation,
            )
        )
    return findings


def macos_posture(timeout: int, max_bytes: int) -> list[Finding]:
    checks = (
        (
            "macos-filevault",
            "FileVault disk encryption",
            ("fdesetup", "status"),
            ("filevault is on",),
            ("filevault is off",),
            "Turn on FileVault after confirming recovery-key handling.",
            "high",
        ),
        (
            "macos-firewall",
            "Application firewall",
            (
                "/usr/libexec/ApplicationFirewall/socketfilterfw",
                "--getglobalstate",
            ),
            ("state = 1", "enabled"),
            ("state = 0", "disabled"),
            "Enable the macOS firewall and review allowed applications.",
            "high",
        ),
        (
            "macos-gatekeeper",
            "Gatekeeper",
            ("spctl", "--status"),
            ("assessments enabled",),
            ("assessments disabled",),
            "Enable Gatekeeper and install software only from trusted sources.",
            "high",
        ),
        (
            "macos-sip",
            "System Integrity Protection",
            ("csrutil", "status"),
            ("status: enabled",),
            ("status: disabled",),
            "Re-enable System Integrity Protection from macOS Recovery.",
            "high",
        ),
        (
            "macos-updates",
            "Automatic update checks",
            ("softwareupdate", "--schedule"),
            (
                "automatic check is on",
                "automatic checking is on",
                "automatic checking for updates is turned on",
            ),
            ("automatic check is off", "automatic checking is off"),
            "Enable automatic update checks in System Settings.",
            "medium",
        ),
    )
    findings: list[Finding] = []
    for identifier, title, command, enabled, disabled, remediation, severity in checks:
        program = command[0] if Path(command[0]).is_file() else find_program(command[0])
        state = None
        if program:
            state = _contains_state(
                _probe((program, *command[1:]), timeout, max_bytes),
                enabled,
                disabled,
            )
        findings.append(
            _posture(
                identifier,
                title,
                state,
                issue=f"{title} was reported disabled.",
                remediation=remediation,
                severity=severity,
            )
        )
    return findings


def _windows_findings(values: dict[str, Any]) -> list[Finding]:
    checks = (
        (
            "windows-firewall",
            "Windows Firewall",
            "Firewall",
            "Enable all required Windows Firewall profiles.",
            "high",
        ),
        (
            "windows-defender",
            "Microsoft Defender real-time protection",
            "Defender",
            "Enable antivirus and real-time protection or verify an approved replacement.",
            "high",
        ),
        (
            "windows-bitlocker",
            "BitLocker volume protection",
            "DiskEncryption",
            "Enable BitLocker after securely backing up recovery keys.",
            "high",
        ),
        (
            "windows-secure-boot",
            "UEFI Secure Boot",
            "SecureBoot",
            "Verify boot compatibility, then enable Secure Boot in firmware.",
            "medium",
        ),
        (
            "windows-uac",
            "User Account Control",
            "UAC",
            "Enable User Account Control through Windows security policy.",
            "high",
        ),
        (
            "windows-updates",
            "Windows Update service",
            "Updates",
            "Enable Windows Update or verify centrally managed patching.",
            "medium",
        ),
    )
    findings = [
        _posture(
            identifier,
            title,
            values.get(key) if isinstance(values.get(key), bool) else None,
            issue=f"{title} was reported disabled.",
            remediation=remediation,
            severity=severity,
        )
        for identifier, title, key, remediation, severity in checks
    ]
    findings.append(
        _posture(
            "windows-secure-boot-certificates",
            "Windows 2023 Secure Boot certificates",
            (
                values.get("SecureBootCertificates")
                if isinstance(values.get("SecureBootCertificates"), bool)
                else None
            ),
            issue=(
                "The 2023 Secure Boot certificate transition is incomplete or "
                "reported an error."
            ),
            remediation=(
                "Install current Windows and OEM firmware updates, then follow "
                "Microsoft's supported certificate-update guidance."
            ),
            severity="high",
            references=(
                (
                    "https://support.microsoft.com/en-us/topic/"
                    "a7be69c9-4634-42e1-9ca1-df06f43f360d"
                ),
            ),
        )
    )
    return findings


def windows_posture(timeout: int, max_bytes: int) -> list[Finding]:
    powershell = find_program("powershell.exe", "pwsh", "powershell")
    if not powershell:
        return [
            _posture(
                "windows-posture",
                "Windows security posture",
                None,
                issue="",
                remediation="Run again with PowerShell available.",
            )
        ]
    script = (
        "$r=[ordered]@{};"
        "try{$p=@(Get-NetFirewallProfile -PolicyStore ActiveStore);"
        "$r.Firewall=($p.Count -gt 0 -and $p.Enabled -notcontains $false -and "
        "$p.DefaultInboundAction -notcontains 'Allow')}"
        "catch{$r.Firewall=$null};"
        "try{$d=Get-MpComputerStatus;"
        "$r.Defender=($d.AntivirusEnabled -and $d.RealTimeProtectionEnabled "
        "-and $d.BehaviorMonitorEnabled -and $d.IoavProtectionEnabled)}"
        "catch{$r.Defender=$null};"
        "try{$b=@((Get-BitLockerVolume).ProtectionStatus);"
        "$r.DiskEncryption=($b.Count -gt 0 -and ($b -notcontains 'Off'))}"
        "catch{$r.DiskEncryption=$null};"
        "try{$r.SecureBoot=Confirm-SecureBootUEFI}catch{$r.SecureBoot=$null};"
        "$status=$null;$certificateError=$null;"
        "try{$s=Get-ItemProperty "
        "'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecureBoot\\Servicing';"
        "$status=$s.UEFICA2023Status;$certificateError=$s.UEFICA2023Error}catch{};"
        "if($null -eq $status){try{$status=(Get-ItemProperty "
        "'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecureBoot'"
        ").UEFICA2023Status}catch{}};"
        "$r.SecureBootCertificates=($status -eq 'Updated' -and "
        "($null -eq $certificateError -or $certificateError -eq 0));"
        "try{$r.UAC=((Get-ItemProperty "
        "'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System'"
        ").EnableLUA -eq 1)}catch{$r.UAC=$null};"
        "try{$r.Updates=((Get-Service wuauserv).StartType -ne 'Disabled')}"
        "catch{$r.Updates=$null};"
        "$r|ConvertTo-Json -Compress"
    )
    result = _probe(
        (
            powershell,
            "-NoLogo",
            "-NoProfile",
            "-NonInteractive",
            "-Command",
            script,
        ),
        timeout,
        max_bytes,
    )
    try:
        parsed = json.loads(result.output) if result.returncode == 0 else {}
        values = parsed if isinstance(parsed, dict) else {}
    except json.JSONDecodeError:
        values = {}
    return _windows_findings(values)


def system_posture(platform: str, timeout: int, max_bytes: int) -> list[Finding]:
    if platform == "linux":
        return linux_posture(timeout, max_bytes)
    if platform == "macos":
        return macos_posture(timeout, max_bytes)
    if platform == "windows":
        return windows_posture(timeout, max_bytes)
    return [
        Finding(
            "unknown",
            "info",
            "unsupported-platform",
            "Operating-system posture",
            "system",
            f"No native posture profile is available for {platform}.",
            "Review this host against its vendor security baseline.",
        )
    ]


def _read_json_file(path: Path, max_bytes: int) -> dict[str, Any]:
    if path.is_symlink():
        raise ToolError(f"refusing symbolic-link JSON input: {path}")
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags)
        try:
            metadata = os.fstat(descriptor)
            if not stat.S_ISREG(metadata.st_mode):
                raise ToolError(f"JSON input is not a regular file: {path}")
            if metadata.st_size > max_bytes:
                raise ToolError(
                    f"{path} exceeds the {max_bytes // 1024 // 1024} MiB limit"
                )
            with os.fdopen(descriptor, "rb", closefd=False) as handle:
                data = handle.read(max_bytes + 1)
        finally:
            os.close(descriptor)
        if len(data) > max_bytes:
            raise ToolError(f"{path} exceeds the JSON input limit")
        value = json.loads(data)
    except (OSError, json.JSONDecodeError) as error:
        raise ToolError(f"cannot read JSON from {path}: {error}") from error
    if not isinstance(value, dict):
        raise ToolError(f"{path} must contain a JSON object")
    _validate_json(value)
    return value


def _validate_kev_catalog(value: dict[str, Any]) -> None:
    for field in ("catalogVersion", "dateReleased"):
        if not isinstance(value.get(field), str) or not value[field].strip():
            raise ToolError(f"CISA KEV catalog has invalid {field} metadata")
    vulnerabilities = value.get("vulnerabilities")
    count = value.get("count")
    if not isinstance(vulnerabilities, list) or type(count) is not int:
        raise ToolError(
            "CISA KEV catalog has invalid count or vulnerabilities metadata"
        )
    if count != len(vulnerabilities):
        raise ToolError("CISA KEV catalog count does not match its vulnerabilities")
    try:
        released = datetime.fromisoformat(value["dateReleased"])
    except ValueError as error:
        raise ToolError("CISA KEV catalog has an invalid release date") from error
    if released.tzinfo is None:
        raise ToolError("CISA KEV catalog release date needs a timezone")
    if (released - datetime.now(UTC)).total_seconds() > 86_400:
        raise ToolError("CISA KEV catalog release date is in the future")


def _kev_catalog_finding(
    value: dict[str, Any],
    path: Path,
    count: int,
    source: str,
) -> Finding:
    released = datetime.fromisoformat(value["dateReleased"])
    age = max(0, (datetime.now(UTC) - released).days)
    stale = age > MAX_KEV_AGE_DAYS
    return Finding(
        status="unknown" if stale else "pass",
        severity="info",
        identifier="cisa-kev",
        title="CISA Known Exploited Vulnerabilities catalog",
        source=source,
        details=(
            f"Loaded {count} KEV records from catalog "
            f"{_clean_text(value['catalogVersion'], 80)}, released "
            f"{_clean_text(value['dateReleased'], 80)} ({age} days old), at "
            f"{_clean_text(path)}."
        ),
        remediation=(
            "Refresh this stale catalog before relying on exploitation status."
            if stale
            else "Refresh the cached catalog regularly."
        ),
        references=("https://www.cisa.gov/known-exploited-vulnerabilities-catalog",),
    )


def _kev_records(value: dict[str, Any]) -> dict[str, dict[str, str]]:
    vulnerabilities = value.get("vulnerabilities")
    if not isinstance(vulnerabilities, list):
        raise ToolError("CISA KEV catalog has no vulnerabilities list")
    if len(vulnerabilities) > MAX_KEV_RECORDS:
        raise ToolError(f"CISA KEV catalog exceeds {MAX_KEV_RECORDS} records")
    records: dict[str, dict[str, str]] = {}
    fields = (
        "vendorProject",
        "product",
        "vulnerabilityName",
        "dateAdded",
        "dueDate",
        "requiredAction",
        "knownRansomwareCampaignUse",
    )
    for record in vulnerabilities:
        if not isinstance(record, dict):
            raise ToolError("CISA KEV catalog contains a non-object record")
        cve = str(record.get("cveID", "")).upper()
        if not CVE_PATTERN.fullmatch(cve):
            raise ToolError("CISA KEV catalog contains an invalid CVE identifier")
        if cve in records:
            raise ToolError(f"CISA KEV catalog contains duplicate {cve}")
        records[cve] = {
            field: _clean_text(record.get(field), 400)
            for field in fields
            if record.get(field)
        }
    if not records:
        raise ToolError("CISA KEV catalog contains no valid CVE records")
    return records


class _CisaRedirectHandler(urllib.request.HTTPRedirectHandler):
    def redirect_request(
        self,
        request: urllib.request.Request,
        file_pointer: Any,
        code: int,
        message: str,
        headers: Any,
        new_url: str,
    ) -> urllib.request.Request | None:
        destination = urlsplit(new_url)
        if destination.scheme != "https" or destination.hostname not in KEV_HOSTS:
            raise urllib.error.HTTPError(
                new_url,
                code,
                "refused CISA redirect outside the fixed HTTPS host",
                headers,
                file_pointer,
            )
        return super().redirect_request(
            request,
            file_pointer,
            code,
            message,
            headers,
            new_url,
        )


def refresh_kev(path: Path, timeout: int, max_bytes: int) -> None:
    if path.is_symlink():
        raise ToolError(f"refusing symbolic-link CISA KEV cache: {path}")
    request = urllib.request.Request(
        CISA_KEV_URL,
        headers={"User-Agent": "scripts-security-audit/1"},
    )
    try:
        opener = urllib.request.build_opener(_CisaRedirectHandler())
        with opener.open(request, timeout=min(timeout, 60)) as response:
            final = urlsplit(response.geturl())
            if final.scheme != "https" or final.hostname not in KEV_HOSTS:
                raise ToolError("CISA KEV response left the fixed HTTPS host")
            length = response.headers.get("Content-Length")
            if length and int(length) > max_bytes:
                raise ToolError("CISA KEV response exceeded the output limit")
            data = response.read(max_bytes + 1)
    except (OSError, TypeError, ValueError, urllib.error.URLError) as error:
        raise ToolError(f"CISA KEV refresh failed: {error}") from error
    if len(data) > max_bytes:
        raise ToolError("CISA KEV response exceeded the configured output limit")
    try:
        value = json.loads(data)
    except json.JSONDecodeError as error:
        raise ToolError(f"CISA KEV returned invalid JSON: {error}") from error
    if not isinstance(value, dict):
        raise ToolError("CISA KEV returned an invalid catalog")
    _validate_json(value)
    _validate_kev_catalog(value)
    _kev_records(value)
    _atomic_private_write(path, data, "CISA KEV cache")


def load_kev(
    args: argparse.Namespace,
    max_bytes: int,
) -> tuple[dict[str, dict[str, str]], Finding]:
    cache = (
        Path(args.kev_catalog).expanduser()
        if args.kev_catalog
        else _default_kev_cache()
    )
    if args.refresh_kev:
        refresh_kev(cache, args.timeout, max_bytes)
    path = cache
    if not path.is_file():
        return {}, Finding(
            status="unknown",
            severity="info",
            identifier="cisa-kev",
            title="CISA Known Exploited Vulnerabilities catalog",
            source="cisa-kev",
            details=(
                "No local KEV catalog was loaded, so CVE exploitation status "
                "is unknown."
            ),
            remediation=(
                "Use --refresh-kev or --kev-catalog PATH to enable KEV enrichment."
            ),
            references=(
                "https://www.cisa.gov/known-exploited-vulnerabilities-catalog",
            ),
        )
    try:
        value = _read_json_file(path, max_bytes)
        _validate_kev_catalog(value)
        records = _kev_records(value)
    except ToolError as error:
        return {}, Finding(
            status="unknown",
            severity="info",
            identifier="cisa-kev",
            title="CISA Known Exploited Vulnerabilities catalog",
            source="cisa-kev",
            details=_clean_text(error),
            remediation="Refresh the catalog or provide a valid --kev-catalog file.",
            references=(
                "https://www.cisa.gov/known-exploited-vulnerabilities-catalog",
            ),
        )
    return records, _kev_catalog_finding(value, path, len(records), "cisa-kev")


def _sarif_cvss(
    result: dict[str, Any],
    rule: dict[str, Any],
) -> tuple[float | None, str | None]:
    score: float | None = None
    vector: str | None = None
    for properties in (result.get("properties"), rule.get("properties")):
        if not isinstance(properties, dict):
            continue
        try:
            candidate = float(properties.get("security-severity"))
        except (TypeError, ValueError):
            candidate = -1
        if 0 <= candidate <= 10 and score is None:
            score = candidate
        for key, value in properties.items():
            if (
                vector is None
                and "cvss" in str(key).casefold()
                and isinstance(value, str)
                and value.upper().startswith("CVSS:")
            ):
                vector = _clean_text(value, 300)
    return score, vector


def _sarif_severity(result: dict[str, Any], score: float | None) -> str:
    if score is not None:
        if score >= 9:
            return "critical"
        if score >= 7:
            return "high"
        if score >= 4:
            return "medium"
        return "low"
    return {"error": "high", "warning": "medium", "note": "low"}.get(
        str(result.get("level", "")).casefold(),
        "medium",
    )


def _sarif_location(result: dict[str, Any]) -> str | None:
    locations = result.get("locations")
    if not isinstance(locations, list) or not locations:
        return None
    physical = _object(_object(locations[0]).get("physicalLocation"))
    artifact = _object(physical.get("artifactLocation"))
    region = _object(physical.get("region"))
    uri = artifact.get("uri")
    line = region.get("startLine")
    if not isinstance(uri, str):
        return None
    if not uri:
        return None
    line_text = line if isinstance(line, int) and line > 0 else None
    return _clean_text(f"{uri}:{line_text}" if line_text else uri, 400)


def _sarif_remediation(result: dict[str, Any], rule: dict[str, Any]) -> str:
    fixes = result.get("fixes")
    if isinstance(fixes, list) and fixes:
        description = _object(fixes[0]).get("description", {})
        text = _nested_text(description, 2_000)
        if text:
            return text
    help_text = _nested_text(rule.get("help"), MAX_JSON_STRING)
    marker = help_text.casefold().find("remediation")
    if marker >= 0:
        help_text = help_text[marker:]
    return (
        _clean_text(help_text, 2_000)
        or "Review the advisory and update, replace, or remove the component."
    )


def _gitleaks_evidence(
    result: dict[str, Any],
    identifier: str,
) -> tuple[str | None, str | None]:
    partial = _object(result.get("partialFingerprints"))
    value = partial.get("commitSha")
    commit = (
        value.lower()
        if isinstance(value, str) and re.fullmatch(r"[0-9a-fA-F]{7,64}", value)
        else None
    )
    locations = result.get("locations")
    if not commit or not isinstance(locations, list) or not locations:
        return commit, None
    physical = _object(_object(locations[0]).get("physicalLocation"))
    artifact = _object(physical.get("artifactLocation"))
    region = _object(physical.get("region"))
    uri = artifact.get("uri")
    line = region.get("startLine")
    if not isinstance(uri, str) or not isinstance(line, int) or line < 1:
        return commit, None
    return commit, _clean_text(f"{commit}:{uri}:{identifier}:{line}", 600)


def parse_sarif(value: dict[str, Any], source: str) -> list[Finding]:
    _validate_json(value)
    if value.get("version") != "2.1.0":
        raise ToolError("SARIF report must use version 2.1.0")
    findings: list[Finding] = []
    runs = value.get("runs")
    if not isinstance(runs, list):
        raise ToolError("SARIF report has no runs list")
    if len(runs) > MAX_SARIF_RUNS:
        raise ToolError(f"SARIF report exceeds {MAX_SARIF_RUNS} runs")
    total_rules = total_results = 0
    for run in runs:
        if not isinstance(run, dict):
            raise ToolError("SARIF run must be an object")
        tool = run.get("tool")
        if not isinstance(tool, dict) or not isinstance(tool.get("driver"), dict):
            raise ToolError("SARIF run has no tool driver object")
        driver = tool["driver"]
        rules = driver.get("rules", [])
        if not isinstance(rules, list):
            raise ToolError("SARIF rules must be a list")
        total_rules += len(rules)
        if total_rules > MAX_SARIF_RULES:
            raise ToolError(f"SARIF report exceeds {MAX_SARIF_RULES} rules")
        if any(not isinstance(rule, dict) for rule in rules):
            raise ToolError("SARIF rules must be objects")
        by_id = {
            str(rule.get("id")): rule
            for rule in rules
            if isinstance(rule, dict) and rule.get("id")
        }
        results = run.get("results", [])
        if not isinstance(results, list):
            raise ToolError("SARIF results must be a list")
        total_results += len(results)
        if total_results > MAX_SARIF_RESULTS:
            raise ToolError(f"SARIF report exceeds {MAX_SARIF_RESULTS} results")
        for result in results:
            if not isinstance(result, dict):
                raise ToolError("SARIF results must be objects")
            identifier = str(result.get("ruleId") or "scanner-finding")
            rule = by_id.get(identifier, {})
            index = result.get("ruleIndex")
            if not rule and isinstance(index, int) and 0 <= index < len(rules):
                candidate = rules[index]
                rule = candidate if isinstance(candidate, dict) else {}
                identifier = str(rule.get("id") or identifier)
            title = (
                _nested_text(rule.get("shortDescription"))
                or _nested_text(rule.get("fullDescription"))
                or identifier
            )
            message = (
                "Sensitive match redacted; rotate the credential if it is real."
                if source == "gitleaks"
                else _nested_text(result.get("message")) or title
            )
            aliases = (
                ()
                if source == "gitleaks"
                else _cve_aliases(
                    identifier,
                    title,
                    message,
                    rule.get("deprecatedIds"),
                    rule.get("properties"),
                    result.get("properties"),
                )
            )
            weaknesses = (
                ()
                if source == "gitleaks"
                else _aliases(
                    CWE_PATTERN,
                    identifier,
                    title,
                    message,
                    rule.get("properties"),
                    result.get("properties"),
                )
            )
            cvss_score, cvss_vector = _sarif_cvss(result, rule)
            references: list[str] = []
            help_uri = rule.get("helpUri")
            if isinstance(help_uri, str):
                clean_uri = _clean_text(help_uri, 1000)
                if clean_uri.startswith("https://"):
                    references.append(clean_uri)
            references.extend(
                f"https://nvd.nist.gov/vuln/detail/{cve}" for cve in aliases
            )
            if source == "osv" and identifier != "scanner-finding":
                references.append(
                    f"https://osv.dev/vulnerability/{quote(identifier, safe='-')}"
                )
            if source == "gitleaks":
                commit, fingerprint = _gitleaks_evidence(result, identifier)
                title = f"Potential secret detected: {title}"
                remediation = (
                    "Revoke and rotate the secret, remove it from current files and "
                    "history, then add a prevention control."
                )
                references = ["https://github.com/gitleaks/gitleaks"]
            else:
                commit = fingerprint = None
                remediation = _sarif_remediation(result, rule)
            findings.append(
                Finding(
                    "issue",
                    _sarif_severity(result, cvss_score),
                    _clean_text(identifier, 160),
                    _clean_text(title, 240),
                    source,
                    _clean_text(message),
                    _clean_text(remediation, 2_000),
                    _sarif_location(result),
                    aliases,
                    tuple(dict.fromkeys(references))[:6],
                    cvss_score=cvss_score,
                    cvss_vector=cvss_vector,
                    weaknesses=weaknesses,
                    commit=commit,
                    fingerprint=fingerprint,
                )
            )
    return findings


def enrich_kev(
    findings: list[Finding],
    records: dict[str, dict[str, str]],
) -> None:
    for finding in findings:
        match = next((records[cve] for cve in finding.aliases if cve in records), None)
        if not match:
            continue
        finding.kev = match
        action = match.get("requiredAction")
        due = match.get("dueDate")
        if action:
            finding.remediation = _clean_text(
                f"{finding.remediation} CISA KEV priority action: {action}"
                + (f" CISA FCEB due date: {due}." if due else ""),
                2_000,
            )
        kev_url = "https://www.cisa.gov/known-exploited-vulnerabilities-catalog"
        finding.references = tuple(dict.fromkeys((*finding.references, kev_url)))


def scanner_command(
    scanner: str,
    executable: str,
    target: Path,
    report: Path,
    timeout: int,
    gitleaks_mode: str | None = None,
) -> list[str]:
    if scanner == "osv":
        command = [
            executable,
            "scan",
            "source",
            "--format",
            "sarif",
            "--output-file",
            str(report),
            "--verbosity",
            "error",
        ]
        if target.is_dir():
            command.append("--recursive")
        return [*command, str(target)]
    if scanner == "trivy":
        return [
            executable,
            "filesystem",
            "--format",
            "sarif",
            "--output",
            str(report),
            "--scanners",
            "vuln,misconfig",
            "--exit-code",
            "0",
            str(target),
        ]
    return [
        executable,
        gitleaks_mode or "dir",
        "--report-format",
        "sarif",
        "--report-path",
        str(report),
        "--redact=100",
        "--no-banner",
        "--timeout",
        str(timeout),
        str(target),
    ]


def _run_scanner_once(
    scanner: str,
    executable: str,
    target: Path,
    timeout: int,
    max_bytes: int,
    gitleaks_mode: str | None = None,
) -> list[Finding]:
    scan_id = f"{scanner}-{gitleaks_mode}" if gitleaks_mode else scanner
    scan_title = (
        f"{scanner} {gitleaks_mode} scan"
        if gitleaks_mode
        else f"{scanner} project scan"
    )
    with tempfile.TemporaryDirectory(prefix="security-audit-") as directory:
        report = Path(directory) / f"{scan_id}.sarif"
        result = _execute(
            scanner_command(
                scanner,
                executable,
                target,
                report,
                timeout,
                gitleaks_mode,
            ),
            timeout=timeout,
            max_bytes=min(max_bytes, 65536),
            watched_file=report,
        )
        if result.timed_out:
            return [
                Finding(
                    "unknown",
                    "info",
                    f"{scan_id}-timeout",
                    scan_title,
                    scanner,
                    f"Scanner exceeded the {timeout}-second limit.",
                    "Narrow the target or raise --timeout after reviewing scan scope.",
                )
            ]
        if not report.is_file():
            detail = "" if scanner == "gitleaks" else _clean_text(result.output, 300)
            return [
                Finding(
                    "unknown",
                    "info",
                    f"{scan_id}-error",
                    scan_title,
                    scanner,
                    f"Scanner produced no SARIF report. {detail}".strip(),
                    "Run security-audit doctor, then run the scanner directly for details.",
                )
            ]
        if report.stat().st_size > max_bytes:
            return [
                Finding(
                    "unknown",
                    "info",
                    f"{scan_id}-output-limit",
                    scan_title,
                    scanner,
                    "SARIF report exceeded the configured output limit.",
                    "Narrow the target and run each project separately.",
                )
            ]
        try:
            value = _read_json_file(report, max_bytes)
            findings = parse_sarif(value, scanner)
        except ToolError as error:
            return [
                Finding(
                    "unknown",
                    "info",
                    f"{scan_id}-sarif",
                    scan_title,
                    scanner,
                    _clean_text(error),
                    "Update the scanner and retry; inspect its raw SARIF if needed.",
                )
            ]
        if findings:
            if result.returncode not in (0, 1):
                findings.append(
                    Finding(
                        "unknown",
                        "info",
                        f"{scan_id}-partial",
                        f"{scan_title} completeness",
                        scanner,
                        f"Findings were parsed, but the scanner exited {result.returncode}.",
                        "Review scanner diagnostics; the report may be incomplete.",
                    )
                )
            return findings
        if result.returncode not in (0,):
            diagnostic = (
                "Sensitive scanner diagnostics suppressed."
                if scanner == "gitleaks"
                else _clean_text(result.output, 300)
            )
            return [
                Finding(
                    "unknown",
                    "info",
                    f"{scan_id}-error",
                    scan_title,
                    scanner,
                    f"Scanner exited {result.returncode}: {diagnostic}",
                    "Run security-audit doctor, then inspect scanner diagnostics.",
                )
            ]
        return [
            Finding(
                "pass",
                "info",
                f"{scan_id}-coverage",
                scan_title,
                scanner,
                "The scanner reported no findings in this target.",
                "Keep dependencies, rules, and scanner databases current.",
            )
        ]


def run_scanner(
    scanner: str,
    target: Path,
    timeout: int,
    max_bytes: int,
) -> list[Finding]:
    executable = find_program("osv-scanner" if scanner == "osv" else scanner)
    if not executable:
        return [
            Finding(
                "unknown",
                "info",
                f"{scanner}-coverage",
                f"{scanner} project scan",
                scanner,
                "Scanner is not installed, so this coverage is unavailable.",
                f"Install {scanner} from its official release channel and run again.",
            )
        ]
    modes: tuple[str | None, ...] = (None,)
    if scanner == "gitleaks":
        modes = ("git", "dir") if (target / ".git").exists() else ("dir",)
    return [
        finding
        for mode in modes
        for finding in _run_scanner_once(
            scanner,
            executable,
            target,
            timeout,
            max_bytes,
            mode,
        )
    ]


def safe_target(path_text: str | None, force: bool) -> Path:
    candidate = Path(path_text or ".").expanduser()
    if candidate.is_symlink():
        raise ToolError(f"refusing symbolic-link scan target: {candidate}")
    try:
        metadata = candidate.stat()
    except OSError as error:
        raise ToolError(f"cannot inspect scan target {candidate}: {error}") from error
    if not (stat.S_ISREG(metadata.st_mode) or stat.S_ISDIR(metadata.st_mode)):
        raise ToolError(f"scan target must be a regular file or directory: {candidate}")
    target = candidate.resolve()
    home = Path.home().resolve()
    if not force and (target == Path(target.anchor) or target == home):
        raise ToolError(
            f"refusing broad scan of {target}; narrow --target or pass --force"
        )
    return target


def selected_scanners(selection: str) -> tuple[str, ...]:
    return SCANNERS if selection == "auto" else (selection,)


def scanner_policy_findings(scanner: str, target: Path) -> list[Finding]:
    root = target if target.is_dir() else target.parent
    files = [
        candidate.name
        for name in SCANNER_POLICY_FILES[scanner]
        if (candidate := root / name).is_file() and not candidate.is_symlink()
    ]
    prefix = f"{scanner.replace('-', '_').upper()}_"
    variables = sorted(name for name in os.environ if name.startswith(prefix))
    if not files and not variables:
        return []
    evidence = []
    if files:
        evidence.append(f"files: {', '.join(files)}")
    if variables:
        evidence.append(f"environment names: {', '.join(variables)}")
    return [
        Finding(
            "unknown",
            "info",
            f"{scanner}-policy",
            f"{scanner} policy and suppression inputs",
            "policy",
            _clean_text(
                "Scanner configuration can change coverage or suppress findings; "
                + "; ".join(evidence)
            ),
            "Review every ignore with an owner, reason, and expiry before treating a clean scan as complete.",
        )
    ]


def doctor_findings(args: argparse.Namespace) -> list[Finding]:
    findings = [
        _posture(
            "platform-support",
            "Native operating-system profile",
            host_os() in {"linux", "macos", "windows"},
            issue="This operating system has no native audit profile.",
            remediation="Use the vendor's security baseline and project scanners.",
        )
    ]
    if args.scope in {"project", "all"}:
        try:
            target = safe_target(args.target, args.force)
        except ToolError as error:
            findings.append(
                Finding(
                    "unknown",
                    "info",
                    "target-doctor",
                    "Project scan target",
                    "doctor",
                    _clean_text(error),
                    "Choose a regular file or directory within the intended project.",
                )
            )
        else:
            findings.append(
                Finding(
                    "pass",
                    "info",
                    "target-doctor",
                    "Project scan target",
                    "doctor",
                    f"Readable regular target: {_clean_text(target)}",
                    "Keep the target narrow enough to review.",
                )
            )
    if args.scope not in {"project", "all"}:
        return findings
    for scanner in selected_scanners(args.scanner):
        name = "osv-scanner" if scanner == "osv" else scanner
        executable = find_program(name)
        if not executable:
            findings.append(
                Finding(
                    "unknown",
                    "info",
                    f"{scanner}-doctor",
                    f"{scanner} scanner",
                    "doctor",
                    "Not installed.",
                    f"Install {scanner} from its official release channel.",
                )
            )
            continue
        version_args = ("version",) if scanner == "gitleaks" else ("--version",)
        result = _probe(
            (executable, *version_args),
            args.timeout,
            MAX_OUTPUT_BYTES,
        )
        version = _clean_text(result.output, 240)
        findings.append(
            Finding(
                "pass" if result.returncode == 0 else "unknown",
                "info",
                f"{scanner}-doctor",
                f"{scanner} scanner",
                "doctor",
                version or f"Installed at {executable}.",
                "Keep the scanner on a supported release.",
            )
        )
    catalog = (
        Path(args.kev_catalog).expanduser()
        if args.kev_catalog
        else _default_kev_cache()
    )
    if args.refresh_kev:
        try:
            refresh_kev(catalog, args.timeout, MAX_OUTPUT_BYTES)
        except ToolError as error:
            findings.append(
                Finding(
                    "unknown",
                    "info",
                    "cisa-kev-refresh",
                    "CISA KEV catalog refresh",
                    "doctor",
                    _clean_text(error),
                    "Check network policy and retry without discarding a valid cache.",
                )
            )
    if catalog.is_file():
        try:
            value = _read_json_file(
                catalog,
                MAX_OUTPUT_BYTES,
            )
            _validate_kev_catalog(value)
            count = len(_kev_records(value))
            findings.append(_kev_catalog_finding(value, catalog, count, "doctor"))
        except ToolError as error:
            findings.append(
                Finding(
                    "unknown",
                    "info",
                    "cisa-kev-doctor",
                    "CISA KEV catalog",
                    "doctor",
                    _clean_text(error),
                    "Replace it with --refresh-kev or a valid --kev-catalog file.",
                )
            )
    else:
        findings.append(
            Finding(
                "unknown",
                "info",
                "cisa-kev-doctor",
                "CISA KEV catalog",
                "doctor",
                "No local catalog found.",
                "Use --refresh-kev or --kev-catalog PATH for exploitation enrichment.",
            )
        )
    return findings


def summary(findings: list[Finding]) -> dict[str, int]:
    result = {"pass": 0, "issue": 0, "unknown": 0}
    for finding in findings:
        result[finding.status] += 1
    for severity in SEVERITIES:
        result[severity] = sum(
            finding.status == "issue" and finding.severity == severity
            for finding in findings
        )
    return result


def report(
    args: argparse.Namespace,
    target: Path | None,
    findings: list[Finding],
) -> dict[str, Any]:
    return {
        "tool": "security-audit",
        "generated_at": datetime.now(UTC).isoformat(),
        "platform": host_os(),
        "command": args.command,
        "scope": args.scope,
        "target": str(target) if target else None,
        "scanner": args.scanner,
        "policy": {
            "fail_on": args.fail_on,
            "kev_always_fails": args.fail_on != "none",
            "timeout_seconds": args.timeout,
        },
        "disclaimer": DISCLAIMER,
        "summary": summary(findings),
        "findings": [asdict(finding) for finding in findings],
    }


def write_report(path_text: str, value: dict[str, Any]) -> None:
    path = Path(path_text).expanduser()
    data = (json.dumps(value, indent=2, sort_keys=True) + "\n").encode()
    if len(data) > MAX_OUTPUT_BYTES:
        raise ToolError(
            f"normalized report exceeds the {MAX_OUTPUT_BYTES}-byte output limit"
        )
    _atomic_private_write(path, data, "report output")


def render_human(value: dict[str, Any]) -> None:
    heading("Security audit")
    print(
        f"Platform: {value['platform']}  Scope: {value['scope']}"
        + (f"  Target: {value['target']}" if value["target"] else "")
    )
    counts = value["summary"]
    print(
        f"Results: {counts['issue']} issue · {counts['unknown']} unknown · "
        f"{counts['pass']} pass"
    )
    order = {"issue": 0, "unknown": 1, "pass": 2}
    findings = sorted(
        value["findings"],
        key=lambda item: (
            order[item["status"]],
            -SEVERITY_RANK[item["severity"]],
            item["title"].casefold(),
        ),
    )
    for finding in findings:
        status = finding["status"].upper()
        code = {"PASS": "1;32", "ISSUE": "1;31", "UNKNOWN": "1;33"}[status]
        label = (
            f"{status}/{finding['severity'].upper()}" if status == "ISSUE" else status
        )
        print(color(f"\n[{label}] {finding['title']}", code))
        print(f"  ID: {finding['identifier']}  Source: {finding['source']}")
        if finding["location"]:
            print(f"  Location: {finding['location']}")
        if finding["aliases"]:
            print(f"  CVE: {', '.join(finding['aliases'])}")
        if finding["weaknesses"]:
            print(f"  CWE: {', '.join(finding['weaknesses'])}")
        if finding["cvss_score"] is not None:
            suffix = (
                f"  Vector: {finding['cvss_vector']}" if finding["cvss_vector"] else ""
            )
            print(f"  CVSS: {finding['cvss_score']:.1f}{suffix}")
        if finding["commit"]:
            print(f"  Commit: {finding['commit']}")
        if finding["fingerprint"]:
            print(f"  Fingerprint: {finding['fingerprint']}")
        print(f"  Detail: {finding['details']}")
        print(f"  Next: {finding['remediation']}")
        if finding["kev"]:
            ransomware = finding["kev"].get("knownRansomwareCampaignUse", "Unknown")
            print(f"  CISA KEV: yes  Known ransomware use: {ransomware}")
            if due := finding["kev"].get("dueDate"):
                print(f"  CISA FCEB due date: {due}")
        for reference in finding["references"]:
            print(f"  Reference: {reference}")
    print(color(f"\nNote: {value['disclaimer']}", "2"))


def threshold_failed(findings: list[Finding], threshold: str) -> bool:
    if threshold == "none":
        return False
    minimum = SEVERITY_RANK[threshold]
    return any(
        finding.status == "issue"
        and (finding.kev is not None or SEVERITY_RANK[finding.severity] >= minimum)
        for finding in findings
    )


def scanner_incomplete(findings: list[Finding], selection: str) -> bool:
    incomplete = [
        finding
        for finding in findings
        if finding.status == "unknown" and finding.source in SCANNERS
    ]
    if selection != "auto":
        return bool(incomplete)
    operational = [
        finding
        for finding in incomplete
        if finding.identifier != f"{finding.source}-coverage"
    ]
    completed = any(
        finding.source in SCANNERS and finding.status in {"pass", "issue"}
        for finding in findings
    )
    return bool(operational) or not completed


def audit(args: argparse.Namespace) -> tuple[Path | None, list[Finding]]:
    max_bytes = MAX_OUTPUT_BYTES
    target = (
        safe_target(args.target, args.force)
        if args.scope in {"project", "all"}
        else None
    )
    findings: list[Finding] = []
    records: dict[str, dict[str, str]] = {}
    if args.scope in {"project", "all"} or args.refresh_kev:
        records, catalog_finding = load_kev(args, max_bytes)
        findings.append(catalog_finding)
    if args.scope in {"system", "all"}:
        findings.extend(system_posture(host_os(), args.timeout, max_bytes))
    if args.scope in {"project", "all"} and target:
        for scanner in selected_scanners(args.scanner):
            findings.extend(scanner_policy_findings(scanner, target))
            findings.extend(run_scanner(scanner, target, args.timeout, max_bytes))
    enrich_kev(findings, records)
    return target, findings


def self_test() -> int:
    assert _selinux_status(ProcessResult(0, "Enforcing\n"))[0] is True
    assert _selinux_status(ProcessResult(0, "Permissive\n"))[0] is False
    failed_selinux = _selinux_status(ProcessResult(1, "permission denied\n"))
    assert failed_selinux == (None, "SELinux: permission denied")
    sarif = {
        "version": "2.1.0",
        "runs": [
            {
                "tool": {
                    "driver": {
                        "name": "fixture",
                        "rules": [
                            {
                                "id": "GHSA-fixture",
                                "shortDescription": {"text": "Fixture CVE-2025-12345"},
                                "deprecatedIds": ["CVE-2025-12345"],
                                "properties": {
                                    "security-severity": "9.1",
                                    "tags": ["CWE-79"],
                                },
                                "helpUri": "https://example.invalid/advisory",
                            }
                        ],
                    }
                },
                "results": [
                    {
                        "ruleId": "GHSA-fixture",
                        "level": "error",
                        "message": {"text": "affected package"},
                        "locations": [
                            {
                                "physicalLocation": {
                                    "artifactLocation": {"uri": "lock.json"},
                                    "region": {"startLine": 7},
                                }
                            }
                        ],
                    }
                ],
            }
        ],
    }
    kev = {
        "catalogVersion": "fixture",
        "dateReleased": "2026-01-01T00:00:00Z",
        "count": 1,
        "vulnerabilities": [
            {
                "cveID": "CVE-2025-12345",
                "requiredAction": "Update the fixture.",
                "dueDate": "2026-01-01",
            }
        ],
    }
    findings = parse_sarif(sarif, "osv")
    _validate_kev_catalog(kev)
    records = _kev_records(kev)
    assert _kev_catalog_finding(kev, Path("fixture.json"), 1, "test").status == (
        "unknown"
    )
    enrich_kev(findings, records)
    assert len(findings) == 1
    assert findings[0].severity == "critical"
    assert findings[0].cvss_score == 9.1
    assert findings[0].weaknesses == ("CWE-79",)
    assert findings[0].location == "lock.json:7"
    assert findings[0].aliases == ("CVE-2025-12345",)
    assert findings[0].kev and findings[0].kev["dueDate"] == "2026-01-01"
    assert findings[0].remediation.startswith("Review the advisory")

    secret = parse_sarif(
        {
            "version": "2.1.0",
            "runs": [
                {
                    "tool": {
                        "driver": {
                            "name": "gitleaks",
                            "rules": [{"id": "generic-api-key"}],
                        }
                    },
                    "results": [
                        {
                            "ruleId": "generic-api-key",
                            "message": {"text": "secret-value-must-not-survive"},
                            "partialFingerprints": {"commitSha": "0123456789abcdef"},
                            "locations": [
                                {
                                    "physicalLocation": {
                                        "artifactLocation": {"uri": "secret.env"},
                                        "region": {"startLine": 3},
                                    }
                                }
                            ],
                        }
                    ],
                }
            ],
        },
        "gitleaks",
    )[0]
    assert "secret-value" not in secret.details
    assert secret.identifier == "generic-api-key"
    assert secret.commit == "0123456789abcdef"
    assert secret.fingerprint == ("0123456789abcdef:secret.env:generic-api-key:3")
    assert _cve_aliases("CVE-2026-12345678") == ("CVE-2026-12345678",)
    assert len(_cve_aliases(*(f"CVE-2026-{number:04d}" for number in range(100)))) == (
        MAX_ALIASES
    )
    assert "\x1b" not in _clean_text("\x1b[31mwarning\u202e")
    hostile = {"version": "2.1.0", "runs": [{"tool": []}]}
    try:
        parse_sarif(hostile, "osv")
    except ToolError:
        pass
    else:
        raise AssertionError("hostile SARIF tool shape was accepted")
    assert (
        scanner_command(
            "gitleaks",
            "gitleaks",
            Path("."),
            Path("report.sarif"),
            12,
        )[-2]
        == "12"
    )
    windows = _windows_findings({"SecureBootCertificates": False})
    certificate = next(
        finding
        for finding in windows
        if finding.identifier == "windows-secure-boot-certificates"
    )
    assert certificate.status == "issue" and certificate.references
    low_kev = Finding(
        "issue",
        "low",
        "fixture-low",
        "Low finding in KEV",
        "osv",
        "Fixture.",
        "Review.",
        aliases=("CVE-2025-12345",),
    )
    enrich_kev([low_kev], records)
    assert low_kev.severity == "low" and threshold_failed([low_kev], "critical")
    assert len(doctor_findings(parse_args(["doctor", "--scope", "system"]))) == 1
    with tempfile.TemporaryDirectory(prefix="security-report-test-") as directory:
        output = Path(directory) / "report.json"
        write_report(output.as_posix(), {"secret": "redacted"})
        assert json.loads(output.read_text()) == {"secret": "redacted"}
        if os.name != "nt":
            assert stat.S_IMODE(output.stat().st_mode) == 0o600
        (output.parent / ".gitleaksignore").write_text(
            "fixture\n",
            encoding="utf-8",
        )
        policy = scanner_policy_findings("gitleaks", output.parent)
        assert policy and policy[0].source == "policy"
    missing = Finding(
        "unknown",
        "info",
        "osv-coverage",
        "OSV unavailable",
        "osv",
        "Missing.",
        "Install it.",
    )
    completed = Finding(
        "pass",
        "info",
        "trivy-coverage",
        "Trivy completed",
        "trivy",
        "Complete.",
        "Keep it current.",
    )
    assert scanner_incomplete([missing], "auto")
    assert not scanner_incomplete([missing, completed], "auto")
    assert scanner_incomplete([missing], "osv")
    assert threshold_failed(findings, "high")
    assert not threshold_failed(findings, "none")
    print("ok: bounded evidence, redaction, CVE/KEV policy, OS checks, and reports")
    return 0


def parse_args(arguments: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="security-audit",
        description=(
            "Audit native OS posture and project dependencies, configuration, "
            "and secrets without changing the host."
        ),
        epilog=DISCLAIMER,
    )
    parser.add_argument(
        "command",
        nargs="?",
        choices=("audit", "doctor"),
        default="audit",
    )
    parser.add_argument(
        "--scope",
        choices=("system", "project", "all"),
        default="all",
    )
    parser.add_argument(
        "--target",
        type=_safe_cli_text,
        help="project file or directory (default: current)",
    )
    parser.add_argument(
        "--scanner",
        choices=("auto", *SCANNERS),
        default="auto",
        help="project scanner; auto runs every installed supported scanner",
    )
    parser.add_argument(
        "--kev-catalog",
        type=_safe_cli_text,
        metavar="FILE",
        help="local CISA KEV JSON catalog/cache path",
    )
    parser.add_argument(
        "--refresh-kev",
        action="store_true",
        help="refresh --kev-catalog or the default cache from CISA's fixed HTTPS feed",
    )
    parser.add_argument(
        "--fail-on",
        choices=("none", "low", "medium", "high", "critical"),
        default="high",
        help="exit 1 at this issue severity",
    )
    parser.add_argument(
        "--timeout",
        type=int,
        default=300,
        help="per-command timeout in seconds (10-1800)",
    )
    parser.add_argument("--json", action="store_true", help="machine-readable report")
    parser.add_argument(
        "--output",
        type=_safe_cli_text,
        metavar="FILE",
        help="also write the full redacted JSON report to a private file",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="allow an explicitly requested filesystem-root or home scan",
    )
    parser.add_argument("--self-test", action="store_true", help=argparse.SUPPRESS)
    args = parser.parse_args(arguments)
    if not 10 <= args.timeout <= 1800:
        parser.error("--timeout must be between 10 and 1800 seconds")
    return args


def main(arguments: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if arguments is None else arguments)
    if args.self_test:
        return self_test()
    try:
        if args.command == "doctor":
            target = None
            findings = doctor_findings(args)
        else:
            target, findings = audit(args)
        value = report(args, target, findings)
        if args.output:
            write_report(args.output, value)
        print_json(value) if args.json else render_human(value)
        if args.command == "audit" and scanner_incomplete(findings, args.scanner):
            return 2
        return 1 if threshold_failed(findings, args.fail_on) else 0
    except (ToolError, OSError) as error:
        message = _clean_text(error)
        if args.json:
            print_json({"tool": "security-audit", "error": message})
        else:
            print(f"security-audit: {message}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
