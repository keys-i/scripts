#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
"""Plan, render, and submit Slurm job matrices from one TOML file."""

from __future__ import annotations

import argparse
import glob
import hashlib
import itertools
import json
import os
import re
import shlex
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path
from tempfile import TemporaryDirectory
from typing import Any

import tomllib
from _common import ToolError, confirmed, heading, require_program

DEFAULT_CLUSTER: dict[str, Any] = {
    "partition": "gpu_cuda",
    "gres": "gpu:a100:1",
    "nodes": 1,
    "ntasks": 1,
    "cpus_per_task": 1,
    "mem": "10G",
    "time": "07:00:00",
}
CLUSTER_KEYS = {
    "account",
    "partition",
    "qos",
    "gres",
    "constraint",
    "nodes",
    "ntasks",
    "cpus_per_task",
    "mem",
    "time",
}
ENVIRONMENT_KEYS = {
    "modules",
    "conda_env",
    "scratch_base",
    "check_gpu",
    "launcher",
    "variables",
}
JOB_KEYS = {
    "name",
    "branch",
    "workdir",
    "command",
    "prepare",
    "prepare_once",
    "configs",
    "matrix",
}
SAFE_DIRECTIVE = re.compile(r"^[A-Za-z0-9_.,:@+/%=-]+$")
SAFE_NAME = re.compile(r"[^A-Za-z0-9_.-]+")
SAFE_VARIABLE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")


@dataclass(frozen=True)
class JobRun:
    name: str
    command: tuple[str, ...]
    prepare: tuple[str, ...]
    prepare_once: bool
    branch: str
    workdir: Path
    cluster: dict[str, Any]
    environment: dict[str, Any]
    values: dict[str, str]


def _table(value: object, label: str) -> dict[str, Any]:
    if value is None:
        return {}
    if not isinstance(value, dict):
        raise ToolError(f"{label} must be a TOML table")
    return value


def _string_list(value: object, label: str, *, allow_empty: bool = True) -> list[str]:
    if not isinstance(value, list) or not all(isinstance(item, str) for item in value):
        raise ToolError(f"{label} must be an array of strings")
    if not allow_empty and not value:
        raise ToolError(f"{label} must not be empty")
    return value


def _check_keys(table: dict[str, Any], allowed: set[str], label: str) -> None:
    if unknown := sorted(table.keys() - allowed):
        raise ToolError(f"unknown {label} key(s): {', '.join(unknown)}")


def _directive(value: object, label: str) -> str:
    text = str(value)
    if not text or not SAFE_DIRECTIVE.fullmatch(text):
        raise ToolError(f"{label} contains unsupported Slurm directive characters")
    return text


def _positive_int(value: object, label: str) -> int:
    if isinstance(value, bool) or not isinstance(value, int) or value < 1:
        raise ToolError(f"{label} must be a positive integer")
    return value


def _detect_account() -> str:
    result = subprocess.run(
        ("groups",),
        check=False,
        capture_output=True,
        text=True,
    )
    return next(
        (group for group in result.stdout.split() if group.startswith("a_")), ""
    )


def _cluster(raw: object) -> dict[str, Any]:
    supplied = _table(raw, "cluster")
    _check_keys(supplied, CLUSTER_KEYS, "cluster")
    cluster = {**DEFAULT_CLUSTER, **supplied}
    gres = str(cluster.get("gres", ""))
    if "qos" not in cluster:
        cluster["qos"] = (
            "mig" if "nvidia_a100_80gb_pcie" in gres else ("gpu" if gres else "")
        )
    if "constraint" not in cluster:
        if "nvidia_a100_80gb_pcie" in gres:
            cluster["constraint"] = "cuda10gb"
        elif "a100" in gres.lower() or "h100" in gres.lower():
            cluster["constraint"] = "cuda80gb"
        elif "l40" in gres.lower():
            cluster["constraint"] = "cuda48gb"
    cluster["account"] = str(cluster.get("account") or _detect_account())
    if not cluster["account"]:
        raise ToolError(
            "cluster.account is required when no a_* Unix group is detected"
        )
    for key in ("nodes", "ntasks", "cpus_per_task"):
        cluster[key] = _positive_int(cluster[key], f"cluster.{key}")
    for key, value in cluster.items():
        if key not in {"nodes", "ntasks", "cpus_per_task"} and value not in {None, ""}:
            cluster[key] = _directive(value, f"cluster.{key}")
    return cluster


def _environment(raw: object) -> dict[str, Any]:
    environment = _table(raw, "environment")
    _check_keys(environment, ENVIRONMENT_KEYS, "environment")
    if "check_gpu" in environment and not isinstance(environment["check_gpu"], bool):
        raise ToolError("environment.check_gpu must be true or false")
    result: dict[str, Any] = {
        "modules": _string_list(environment.get("modules", []), "environment.modules"),
        "launcher": _string_list(
            environment.get("launcher", ["srun", "--ntasks=1"]),
            "environment.launcher",
            allow_empty=False,
        ),
        "check_gpu": bool(environment.get("check_gpu", True)),
    }
    for key in ("conda_env", "scratch_base"):
        if value := environment.get(key):
            if not isinstance(value, str) or "\n" in value or "\0" in value:
                raise ToolError(f"environment.{key} must be a single-line string")
            result[key] = value.format(user=os.environ.get("USER", "user"))
    if (conda_env := result.get("conda_env")) and not Path(conda_env).is_absolute():
        raise ToolError("environment.conda_env must be an absolute path")
    variables = _table(environment.get("variables"), "environment.variables")
    for name, value in variables.items():
        if not SAFE_VARIABLE.fullmatch(name):
            raise ToolError(f"invalid environment variable name: {name}")
        if not isinstance(value, (str, int, float, bool)):
            raise ToolError(f"environment variable {name} must be a scalar")
        if "\n" in str(value) or "\0" in str(value):
            raise ToolError(f"environment variable {name} must be single-line")
    result["variables"] = variables
    return result


def _format_tokens(
    tokens: list[str], values: dict[str, str], label: str
) -> tuple[str, ...]:
    try:
        return tuple(token.format_map(values) for token in tokens)
    except KeyError as error:
        raise ToolError(
            f"{label} references unknown value {{{error.args[0]}}}"
        ) from error


def _config_paths(patterns: object, base: Path) -> list[str]:
    if patterns is None:
        return [""]
    paths: list[str] = []
    for pattern in _string_list(patterns, "job.configs", allow_empty=False):
        candidate = pattern if Path(pattern).is_absolute() else str(base / pattern)
        matches = sorted(path for path in glob.glob(candidate) if Path(path).is_file())
        if not matches:
            raise ToolError(f"job.configs pattern matched no files: {pattern}")
        paths.extend(str(Path(path).resolve()) for path in matches)
    return list(dict.fromkeys(paths))


def _matrix(raw: object) -> tuple[list[str], list[tuple[object, ...]]]:
    matrix = _table(raw, "job.matrix")
    keys = list(matrix)
    values: list[list[object]] = []
    for key, choices in matrix.items():
        if not SAFE_VARIABLE.fullmatch(key):
            raise ToolError(f"invalid matrix key: {key}")
        if not isinstance(choices, list) or not choices:
            raise ToolError(f"job.matrix.{key} must be a non-empty array")
        if not all(isinstance(choice, (str, int, float, bool)) for choice in choices):
            raise ToolError(f"job.matrix.{key} values must be scalars")
        values.append(choices)
    return keys, list(itertools.product(*values)) if values else [()]


def expand_config(data: dict[str, Any], source: Path, limit: int) -> list[JobRun]:
    if set(data) - {"cluster", "environment", "jobs"}:
        unknown = ", ".join(sorted(set(data) - {"cluster", "environment", "jobs"}))
        raise ToolError(f"unknown top-level key(s): {unknown}")
    cluster = _cluster(data.get("cluster"))
    environment = _environment(data.get("environment"))
    jobs = data.get("jobs")
    if not isinstance(jobs, list) or not jobs:
        raise ToolError("at least one [[jobs]] table is required")

    runs: list[JobRun] = []
    for job_number, raw_job in enumerate(jobs, 1):
        job = _table(raw_job, f"jobs[{job_number}]")
        _check_keys(job, JOB_KEYS, f"jobs[{job_number}]")
        name = job.get("name")
        if not isinstance(name, str) or not name.strip():
            raise ToolError(f"jobs[{job_number}].name is required")
        command = _string_list(
            job.get("command"),
            f"jobs[{job_number}].command",
            allow_empty=False,
        )
        prepare = _string_list(
            job.get("prepare", []),
            f"jobs[{job_number}].prepare",
        )
        branch = job.get("branch", "")
        if not isinstance(branch, str) or "\n" in branch:
            raise ToolError(f"jobs[{job_number}].branch must be a single-line string")
        workdir_value = job.get("workdir", ".")
        if not isinstance(workdir_value, str):
            raise ToolError(f"jobs[{job_number}].workdir must be a string")
        workdir = (
            Path(workdir_value)
            if Path(workdir_value).is_absolute()
            else source.parent / workdir_value
        ).resolve()
        if "prepare_once" in job and not isinstance(job["prepare_once"], bool):
            raise ToolError(f"jobs[{job_number}].prepare_once must be true or false")
        matrix_keys, combinations = _matrix(job.get("matrix"))
        configs = _config_paths(job.get("configs"), source.parent)
        for config_path, combination in itertools.product(configs, combinations):
            values = {
                key: str(value)
                for key, value in zip(matrix_keys, combination, strict=True)
            }
            values.update(
                {
                    "config": config_path,
                    "branch": branch,
                    "workdir": str(workdir),
                }
            )
            labels = [Path(config_path).stem] if config_path else []
            labels.extend(f"{key}-{values[key]}" for key in matrix_keys)
            run_name = SAFE_NAME.sub("-", "-".join((name, *labels))).strip("-._")
            run_name = f"{run_name}-{len(runs) + 1:03d}"[:100]
            runs.append(
                JobRun(
                    name=run_name,
                    command=_format_tokens(command, values, "job.command"),
                    prepare=_format_tokens(prepare, values, "job.prepare"),
                    prepare_once=bool(job.get("prepare_once", False)),
                    branch=branch,
                    workdir=workdir,
                    cluster=cluster,
                    environment=environment,
                    values=values,
                )
            )
            if len(runs) > limit:
                raise ToolError(
                    f"matrix expands beyond --limit {limit}; narrow it or raise the limit"
                )
    return runs


def read_runs(path: Path, limit: int) -> list[JobRun]:
    if not path.is_file():
        raise ToolError(f"config does not exist: {path}")
    try:
        with path.open("rb") as handle:
            data = tomllib.load(handle)
    except tomllib.TOMLDecodeError as error:
        raise ToolError(f"invalid TOML: {error}") from error
    return expand_config(data, path.resolve(), limit)


def _quoted(command: tuple[str, ...]) -> str:
    return shlex.join(command)


def render_script(run_spec: JobRun) -> str:
    cluster = run_spec.cluster
    environment = run_spec.environment
    directives: list[tuple[str, object]] = [
        ("job-name", run_spec.name),
        ("partition", cluster["partition"]),
        ("nodes", cluster["nodes"]),
        ("ntasks", cluster["ntasks"]),
        ("cpus-per-task", cluster["cpus_per_task"]),
        ("mem", cluster["mem"]),
        ("time", cluster["time"]),
        ("account", cluster["account"]),
        ("output", "logs/%x-%j.out"),
        ("error", "logs/%x-%j.err"),
        ("export", "NONE"),
    ]
    if cluster.get("qos"):
        directives.append(("qos", cluster["qos"]))
    if cluster.get("gres"):
        directives.append(("gres", cluster["gres"]))
    if cluster.get("constraint"):
        directives.append(("constraint", cluster["constraint"]))

    lines = ["#!/bin/bash --login"]
    lines.extend(f"#SBATCH --{key}={value}" for key, value in directives)
    lines.extend(
        [
            "",
            "set -euo pipefail",
            f"WORKDIR={shlex.quote(str(run_spec.workdir))}",
            'mkdir -p "$WORKDIR/logs"',
            'cd "$WORKDIR"',
            "",
            'echo "host: $(hostname)"',
            'echo "job: ${SLURM_JOB_ID:-local} · ${SLURM_JOB_NAME:-unknown}"',
        ]
    )
    if run_spec.branch:
        lines.extend(
            [
                f"EXPECTED_BRANCH={shlex.quote(run_spec.branch)}",
                'ACTIVE_BRANCH="$(git branch --show-current)"',
                'if [[ "$ACTIVE_BRANCH" != "$EXPECTED_BRANCH" ]]; then',
                '  echo "Expected branch $EXPECTED_BRANCH; found $ACTIVE_BRANCH" >&2',
                "  exit 1",
                "fi",
            ]
        )
    modules = environment["modules"]
    if modules:
        lines.extend(
            [
                "",
                "type module >/dev/null 2>&1 || { echo 'Environment modules are unavailable' >&2; exit 1; }",
                "module purge",
                f"module load {_quoted(tuple(modules))}",
            ]
        )
    if conda_env := environment.get("conda_env"):
        lines.extend(
            [
                "",
                "unset CONDA_PREFIX CONDA_DEFAULT_ENV CONDA_PROMPT_MODIFIER CONDA_SHLVL || true",
                'if [[ -n "${ROOTMINIFORGE:-}" ]]; then',
                '  source "$ROOTMINIFORGE/etc/profile.d/conda.sh"',
                "elif command -v conda >/dev/null 2>&1; then",
                '  source "$(conda info --base)/etc/profile.d/conda.sh"',
                "else",
                "  echo 'Conda is unavailable after loading modules' >&2",
                "  exit 1",
                "fi",
                f"conda activate {shlex.quote(conda_env)}",
                f'[[ "$(realpath "$CONDA_PREFIX")" == {shlex.quote(str(Path(conda_env).resolve()))} ]] || {{ echo \'Wrong Conda environment active\' >&2; exit 1; }}',
            ]
        )
    scratch = environment.get(
        "scratch_base",
        f"/scratch/user/{os.environ.get('USER', 'user')}",
    )
    lines.extend(
        [
            "",
            f"SCRATCH_BASE={shlex.quote(scratch)}",
            'export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$SCRATCH_BASE/.cache}"',
            'export PIP_CACHE_DIR="${PIP_CACHE_DIR:-$XDG_CACHE_HOME/pip}"',
            'export HF_HOME="${HF_HOME:-$XDG_CACHE_HOME/huggingface}"',
            'export TORCH_HOME="${TORCH_HOME:-$XDG_CACHE_HOME/torch}"',
            'export MPLCONFIGDIR="${MPLCONFIGDIR:-$XDG_CACHE_HOME/matplotlib}"',
            'mkdir -p "$XDG_CACHE_HOME" "$PIP_CACHE_DIR" "$HF_HOME" "$TORCH_HOME" "$MPLCONFIGDIR"',
            'export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-1}"',
            'export MKL_NUM_THREADS="${SLURM_CPUS_PER_TASK:-1}"',
            "export PYTHONUNBUFFERED=1",
            "export SLURM_EXPORT_ENV=ALL",
        ]
    )
    for name, value in environment["variables"].items():
        lines.append(f"export {name}={shlex.quote(str(value))}")
    lines.extend(
        [
            "",
            'echo "workdir: $WORKDIR"',
            'echo "python: $(command -v python || true)"',
            'echo "cache: $XDG_CACHE_HOME"',
        ]
    )
    if environment["check_gpu"] and cluster.get("gres"):
        lines.extend(["", "nvidia-smi || { echo 'GPU check failed' >&2; exit 1; }"])

    launcher = tuple(environment["launcher"])
    if run_spec.prepare:
        prepare_command = _quoted((*launcher, *run_spec.prepare))
        lines.extend(["", 'echo "preparing shared inputs"'])
        if run_spec.prepare_once:
            prepare_id = hashlib.sha256(
                "\0".join(run_spec.prepare).encode()
            ).hexdigest()[:12]
            lines.extend(
                [
                    "command -v flock >/dev/null 2>&1 || { echo 'flock is required for prepare_once' >&2; exit 1; }",
                    f'PREPARE_MARKER="$WORKDIR/.slurm-prepare-{prepare_id}.done"',
                    "(",
                    "  flock -x 200",
                    '  if [[ ! -e "$PREPARE_MARKER" ]]; then',
                    f"    {prepare_command}",
                    '    touch "$PREPARE_MARKER"',
                    "  fi",
                    f') 200>"$WORKDIR/.slurm-prepare-{prepare_id}.lock"',
                ]
            )
        else:
            lines.append(prepare_command)
    lines.extend(
        [
            "",
            'echo "running job"',
            _quoted((*launcher, *run_spec.command)),
            "",
        ]
    )
    return "\n".join(lines)


def show_plan(runs: list[JobRun], *, as_json: bool) -> None:
    if as_json:
        print(
            json.dumps(
                [
                    {
                        "name": run_spec.name,
                        "workdir": str(run_spec.workdir),
                        "branch": run_spec.branch,
                        "command": list(run_spec.command),
                        "values": run_spec.values,
                    }
                    for run_spec in runs
                ],
                indent=2,
            )
        )
        return
    heading(f"Slurm plan · {len(runs)} job(s)")
    for number, run_spec in enumerate(runs, 1):
        print(f"{number:>4}  {run_spec.name:<42} {shlex.join(run_spec.command)}")


def output_paths(runs: list[JobRun], output: Path) -> list[Path]:
    return [
        output / f"{number:03d}-{run_spec.name}.sbatch"
        for number, run_spec in enumerate(runs, 1)
    ]


def write_scripts(runs: list[JobRun], output: Path) -> list[Path]:
    output.mkdir(parents=True, exist_ok=True)
    paths = output_paths(runs, output)
    for path, run_spec in zip(paths, runs, strict=True):
        path.write_text(render_script(run_spec), encoding="utf-8")
        path.chmod(0o755)
    return paths


def mutate(args: argparse.Namespace, runs: list[JobRun]) -> int:
    output = args.output.resolve()
    paths = output_paths(runs, output)
    heading(f"{args.action.title()} preview")
    for path in paths:
        print(path)
    if not args.apply:
        print("\nPreview only. Add --apply to continue.")
        return 0
    if not confirmed(
        apply=True,
        yes=args.yes,
        prompt=f"{args.action} {len(paths)} Slurm job(s)",
    ):
        print("Cancelled.")
        return 1
    paths = write_scripts(runs, output)
    if args.action == "render":
        print(f"Rendered {len(paths)} scripts in {output}")
        return 0
    sbatch = require_program("sbatch")
    for path, run_spec in zip(paths, runs, strict=True):
        (run_spec.workdir / "logs").mkdir(parents=True, exist_ok=True)
        subprocess.run((sbatch, str(path)), cwd=run_spec.workdir, check=True)
    return 0


def self_test() -> int:
    config: dict[str, Any] = {
        "cluster": {"account": "a_test"},
        "environment": {"check_gpu": False},
        "jobs": [
            {
                "name": "flowids",
                "branch": "m0",
                "prepare": ["python", "prepare.py"],
                "prepare_once": True,
                "command": ["python", "-m", "src.main", "--seed", "{seed}"],
                "matrix": {"seed": [1, 2], "model": ["small", "large"]},
            }
        ],
    }
    runs = expand_config(config, Path.cwd() / "jobs.toml", 10)
    assert len(runs) == 4
    assert runs[0].command[-1] == "1"
    rendered = render_script(runs[0])
    assert "git checkout" not in rendered
    assert "EXPECTED_BRANCH=m0" in rendered
    assert 'touch "$PREPARE_MARKER"' in rendered
    with TemporaryDirectory() as temporary:
        arguments = argparse.Namespace(
            action="render",
            output=Path(temporary),
            apply=True,
            yes=True,
        )
        assert mutate(arguments, runs[:1]) == 0
        assert len(list(Path(temporary).glob("*.sbatch"))) == 1
    print("ok: TOML matrix expansion, branch guard, and batch rendering")
    return 0


def parse_args(arguments: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="slurm",
        description="Plan, render, and submit Slurm matrices from TOML.",
    )
    parser.add_argument(
        "action",
        nargs="?",
        choices=("plan", "render", "submit"),
        default="plan",
    )
    parser.add_argument("--config", type=Path, default=Path("slurm.toml"))
    parser.add_argument("--output", type=Path, default=Path("slurm-build"))
    parser.add_argument("--limit", type=int, default=1000)
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--apply", action="store_true")
    parser.add_argument("--yes", action="store_true")
    parser.add_argument("--self-test", action="store_true", help=argparse.SUPPRESS)
    return parser.parse_args(arguments)


def main(arguments: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if arguments is None else arguments)
    if args.self_test:
        return self_test()
    try:
        if args.limit < 1:
            raise ToolError("--limit must be positive")
        runs = read_runs(args.config, args.limit)
        if args.action == "plan":
            show_plan(runs, as_json=args.json)
            return 0
        return mutate(args, runs)
    except (ToolError, OSError, subprocess.CalledProcessError) as error:
        print(f"slurm: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
