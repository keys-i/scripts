---
{
  "summary": "Read text, inspect tables, present slides, paint text canvases, and run timers locally.",
  "platform": "any",
  "privilege": "user",
  "executable": "apps",
  "directWhen": ["open"],
  "parameters": [
    {
      "name": "action",
      "label": "Action",
      "required": true,
      "default": "snapshot",
      "choices": [
        {"value": "snapshot", "label": "Print a snapshot"},
        {"value": "open", "label": "Open interactive app"}
      ]
    },
    {
      "name": "app",
      "label": "App",
      "required": true,
      "default": "read",
      "choices": [
        {"value": "read", "label": "Text reader"},
        {"value": "table", "label": "CSV or TSV table"},
        {"value": "slides", "label": "Markdown slides"},
        {"value": "paint", "label": "Text canvas"},
        {"value": "timer", "label": "Countdown timer"}
      ]
    },
    {
      "name": "input",
      "label": "Input file",
      "required": true,
      "placeholder": "notes.md, data.csv, or talk.md",
      "when": {"app": ["read", "table", "slides"]}
    },
    {
      "name": "canvas",
      "label": "Existing text canvas",
      "placeholder": "optional drawing.txt",
      "when": {"app": ["paint"]}
    },
    {
      "name": "find",
      "label": "Find text",
      "flag": "--find",
      "placeholder": "case-insensitive query",
      "when": {"app": ["read"]}
    },
    {
      "name": "delimiter",
      "label": "Table delimiter",
      "flag": "--delimiter",
      "choices": [
        {"value": "comma", "label": "Comma"},
        {"value": "tab", "label": "Tab"}
      ],
      "when": {"app": ["table"]}
    },
    {
      "name": "limit",
      "label": "Snapshot rows or lines",
      "flag": "--limit",
      "placeholder": "1 to 1000, default 20",
      "when": {"action": ["snapshot"], "app": ["read", "table"]}
    },
    {
      "name": "page",
      "label": "Slide page",
      "flag": "--page",
      "placeholder": "1 to 512, default 1",
      "when": {"app": ["slides"]}
    },
    {
      "name": "width",
      "label": "New canvas width",
      "flag": "--width",
      "placeholder": "1 to 240, default 40",
      "when": {"app": ["paint"]}
    },
    {
      "name": "height",
      "label": "New canvas height",
      "flag": "--height",
      "placeholder": "1 to 80, default 16",
      "when": {"app": ["paint"]}
    },
    {
      "name": "output",
      "label": "New paint output",
      "flag": "--output",
      "placeholder": "new drawing.txt",
      "when": {"action": ["open"], "app": ["paint"]}
    },
    {
      "name": "seconds",
      "label": "Timer seconds",
      "flag": "--seconds",
      "required": true,
      "placeholder": "1 to 86400",
      "when": {"app": ["timer"]}
    },
    {
      "name": "elapsed",
      "label": "Elapsed seconds",
      "flag": "--elapsed",
      "placeholder": "0 to timer duration",
      "when": {"action": ["snapshot"], "app": ["timer"]}
    },
    {
      "name": "label",
      "label": "Timer label",
      "flag": "--label",
      "placeholder": "focus",
      "when": {"app": ["timer"]}
    },
    {
      "name": "format",
      "label": "Snapshot format",
      "required": true,
      "default": "--plain",
      "choices": [
        {"value": "--plain", "label": "Plain text"},
        {"value": "--json", "label": "JSON"}
      ],
      "when": {"action": ["snapshot"]}
    }
  ]
}
